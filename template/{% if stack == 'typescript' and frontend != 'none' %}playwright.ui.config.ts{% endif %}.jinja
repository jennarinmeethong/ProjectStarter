const port = 4173;

export default defineConfig({
  testDir: "e2e-ui",
  forbidOnly: true,
  retries: 0,
  reporter: [["list"], ["html", { open: "never", outputFolder: "playwright-report-ui" }]],
  use: { baseURL: `http://127.0.0.1:${String(port)}`, trace: "retain-on-failure" },
  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],
  webServer: {
{%- if frontend == 'nextjs' %}
    command: `npm run build && npx next start --hostname 127.0.0.1 --port ${String(port)}`,
{%- elif frontend == 'react-native' %}
    command: `npm run build && npx expo serve --port ${String(port)}`,
{%- elif frontend == 'angular' %}
    command: `npx ng serve --configuration production --host 127.0.0.1 --port ${String(port)}`,
{%- else %}
    command: `npm run build && npx vite preview --host 127.0.0.1 --port ${String(port)} --strictPort`,
