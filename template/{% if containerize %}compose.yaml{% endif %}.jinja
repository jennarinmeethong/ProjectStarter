# Local run: docker compose up --build
# Hardened defaults: read-only filesystem, no extra Linux capabilities, no privilege escalation.
{%- if datastores %}
# Credentials here are for local development only; real ones come from the deployment's secret store.
{%- endif %}
services:
  app:
    build: .
    image: {{ project_name | lower }}:local
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: [/tmp]
{%- if http_api %}
    # Published on the host's loopback only.
    ports: ["127.0.0.1:8080:8080"]
{%- endif %}
{%- if datastores %}
    environment:
{%- if 'postgres' in datastores %}
      DATABASE_URL: postgresql://app:${POSTGRES_PASSWORD:-local-dev-only}@postgres:5432/app
{%- endif %}
{%- if mysql_engine %}
      MYSQL_URL: mysql://app:${MYSQL_PASSWORD:-local-dev-only}@{{ mysql_engine }}:3306/app
{%- endif %}
{%- if 'sqlserver' in datastores %}
      # Local development only: the container's certificate is self-signed.
      SQLSERVER_URL: sqlserver://sa:${MSSQL_SA_PASSWORD:-Local-dev-only-1}@sqlserver:1433/app?trustServerCertificate=true
{%- endif %}
{%- if 'mongodb' in datastores %}
      MONGODB_URL: mongodb://app:${MONGO_PASSWORD:-local-dev-only}@mongodb:27017/app?authSource=admin
{%- endif %}
{%- if 'dynamodb' in datastores %}
      DYNAMODB_TABLE: export_artifacts
      DYNAMODB_ENDPOINT: http://dynamodb:8000
      # DynamoDB Local accepts any credentials; real AWS uses the SDK's default credential chain.
      AWS_REGION: us-east-1
      AWS_DEFAULT_REGION: us-east-1
      AWS_ACCESS_KEY_ID: local
      AWS_SECRET_ACCESS_KEY: local
{%- endif %}
{%- if 'cosmosdb' in datastores %}
      COSMOS_ENDPOINT: http://cosmosdb:8081
      # The emulator's published well-known key, not a secret. Real accounts take the key from a secret store.
      COSMOS_KEY: C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
      COSMOS_DATABASE: app
      # Local only: real accounts get their database and container from infrastructure as code (ADR 0003).
      COSMOS_CREATE_IF_MISSING: "true"
      # Lets the Rust SDK accept plain HTTP for this host (emulator only).
      AZURE_COSMOS_EMULATOR_HOST: cosmosdb
{%- endif %}
{%- if 'redis' in datastores %}
      REDIS_URL: redis://redis:6379/0
{%- endif %}
    depends_on:
{%- if 'postgres' in datastores %}
      postgres:
        condition: service_healthy
{%- endif %}
{%- if mysql_engine %}
      {{ mysql_engine }}:
        condition: service_healthy
{%- endif %}
{%- if 'sqlserver' in datastores %}
      sqlserver-migrate:
        condition: service_completed_successfully
{%- endif %}
{%- if 'mongodb' in datastores %}
      mongodb:
        condition: service_healthy
{%- endif %}
{%- if 'dynamodb' in datastores %}
      dynamodb-migrate:
        condition: service_completed_successfully
{%- endif %}
{%- if 'cosmosdb' in datastores %}
      cosmosdb:
        condition: service_healthy
{%- endif %}
{%- if 'redis' in datastores %}
      redis:
        condition: service_healthy
{%- endif %}
{%- endif %}
{%- if 'postgres' in datastores %}

  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_DB: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-local-dev-only}
    volumes:
      # Applied once, in file-name order, when the volume is first created (ADR 0003).
      - ./migrations:/docker-entrypoint-initdb.d:ro
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 2s
      retries: 30
{%- endif %}
{%- if mysql_engine %}

  {{ mysql_engine }}:
    image: {{ 'mysql:8.4' if mysql_engine == 'mysql' else 'mariadb:11.8' }}
    environment:
      MYSQL_DATABASE: app
      MYSQL_USER: app
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-local-dev-only}
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
    volumes:
      # Applied once, in file-name order, when the volume is first created (ADR 0003).
      - ./migrations/mysql:/docker-entrypoint-initdb.d:ro
      - {{ mysql_engine }}-data:/var/lib/mysql
    healthcheck:
{%- if mysql_engine == 'mysql' %}
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uapp -p$${MYSQL_PASSWORD}"]
{%- else %}
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
{%- endif %}
      interval: 2s
      retries: 60
{%- endif %}
{%- if 'sqlserver' in datastores %}

  sqlserver:
    # SQL Server Developer edition: free for development and testing under Microsoft's EULA (ADR 0003).
    image: mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: Developer
      MSSQL_SA_PASSWORD: ${MSSQL_SA_PASSWORD:-Local-dev-only-1}
    volumes:
      - sqlserver-data:/var/opt/mssql
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$${MSSQL_SA_PASSWORD}\" -C -Q 'SELECT 1' -b"]
      interval: 5s
      retries: 40

  # SQL Server has no init-script hook: this one-shot job creates the database and applies migrations/sqlserver.
  sqlserver-migrate:
    image: mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
    depends_on:
      sqlserver:
        condition: service_healthy
    environment:
      MSSQL_SA_PASSWORD: ${MSSQL_SA_PASSWORD:-Local-dev-only-1}
    volumes:
      - ./migrations/sqlserver:/migrations:ro
    entrypoint: ["/bin/bash", "-c"]
    command:
      - >-
        sqlcmd() { /opt/mssql-tools18/bin/sqlcmd -S sqlserver -U sa -P "$${MSSQL_SA_PASSWORD}" -C -b "$$@"; } &&
        sqlcmd -Q "IF DB_ID(N'app') IS NULL CREATE DATABASE app" &&
        for f in /migrations/*.sql; do sqlcmd -d app -i "$$f"; done
{%- endif %}
{%- if 'mongodb' in datastores %}

  mongodb:
    # MongoDB Community Server is under the SSPL (ADR 0003). The adapter creates its own indexes.
    image: mongo:8.0
    environment:
      MONGO_INITDB_ROOT_USERNAME: app
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD:-local-dev-only}
    volumes:
      - mongodb-data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
      interval: 2s
      retries: 30
{%- endif %}
{%- if 'dynamodb' in datastores %}

  dynamodb:
    # DynamoDB Local: free for development and testing under AWS's DynamoDB Local license (ADR 0003).
    # In memory: tables and data reset when the container restarts.
    image: amazon/dynamodb-local:2.6.1
    command: ["-jar", "DynamoDBLocal.jar", "-sharedDb", "-inMemory"]

  # Creates every table in infra/dynamodb (create-table input JSON) that does not exist yet.
  dynamodb-migrate:
    image: amazon/aws-cli:2.27.0
    depends_on:
      dynamodb:
        condition: service_started
    environment:
      AWS_REGION: us-east-1
      AWS_ACCESS_KEY_ID: local
      AWS_SECRET_ACCESS_KEY: local
    volumes:
      - ./infra/dynamodb:/tables:ro
    entrypoint: ["/bin/bash", "-c"]
    command:
      - >-
        ddb() { aws dynamodb --endpoint-url http://dynamodb:8000 "$$@"; } &&
        for _ in $$(seq 1 60); do ddb list-tables >/dev/null 2>&1 && break; sleep 1; done &&
        for f in /tables/*.json; do
        ddb describe-table --table-name "$$(basename "$$f" .json)" >/dev/null 2>&1 ||
        ddb create-table --cli-input-json "file://$$f" >/dev/null || exit 1;
        done
{%- endif %}
{%- if 'cosmosdb' in datastores %}

  cosmosdb:
    # Azure Cosmos DB emulator (vNext, NoSQL API): for development and testing only (ADR 0003).
    image: mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:vnext-preview
    command: ["--protocol", "http"]
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8080/ready"]
      interval: 2s
      retries: 60
{%- endif %}
{%- if 'redis' in datastores %}

  redis:
    image: redis:8-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      retries: 30
{%- endif %}
{%- if frontend != 'none' %}

  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    image: {{ project_name | lower }}-web:local
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: [/tmp]
    # Published on the host's loopback only.
    ports: ["127.0.0.1:8081:8080"]
{%- endif %}
{%- if 'postgres' in datastores or mysql_engine or 'sqlserver' in datastores or 'mongodb' in datastores %}

volumes:
{%- if 'postgres' in datastores %}
  postgres-data:
{%- endif %}
{%- if mysql_engine %}
  {{ mysql_engine }}-data:
{%- endif %}
{%- if 'sqlserver' in datastores %}
  sqlserver-data:
{%- endif %}
{%- if 'mongodb' in datastores %}
  mongodb-data:
{%- endif %}
{%- endif %}
