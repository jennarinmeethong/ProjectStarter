# syntax=docker/dockerfile:1
# Checked by hadolint (.hadolint.yaml) and ci/check-dockerfile.sh: pinned base images, multi-stage,
# no build tools or dev dependencies at runtime, and the final stage runs as a non-root user.
{%- if stack == 'typescript' %}

FROM node:24-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && mkdir -p node_modules

# Node 24 runs TypeScript directly (type stripping), so there is no separate compile step.
FROM node:24-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
{%- if http_api %}
# The server binds loopback unless told otherwise; inside the container it must listen on all interfaces.
ENV HOST=0.0.0.0 PORT=8080
EXPOSE 8080
{%- endif %}
# Numeric UID of the image's `node` user, so Kubernetes runAsNonRoot can verify it.
USER 1000:1000
CMD ["node", "src/bootstrap/main.ts"]
{%- elif stack == 'python' %}

FROM ghcr.io/astral-sh/uv:0.12.5 AS uv

FROM python:3.13-slim AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.13-slim AS runtime
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid 10001 --no-create-home app
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
{%- if http_api %}
# The server binds loopback unless told otherwise; inside the container it must listen on all interfaces.
ENV HOST=0.0.0.0 PORT=8080
EXPOSE 8080
{%- endif %}
USER 10001:10001
CMD ["{{ project_name | lower }}"]
{%- else %}

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig BannedSymbols.txt CodeMetricsConfig.txt ./
COPY src ./src
RUN dotnet publish src/{{ dotnet_name }}.Bootstrap/{{ dotnet_name }}.Bootstrap.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/{% if http_api %}aspnet{% else %}runtime{% endif %}:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
{%- if http_api %}
# The server binds loopback unless told otherwise; inside the container it must listen on all interfaces.
ENV HOST=0.0.0.0 PORT=8080
EXPOSE 8080
{%- endif %}
USER $APP_UID
ENTRYPOINT ["dotnet", "{{ dotnet_name }}.Bootstrap.dll"]
{%- endif %}
