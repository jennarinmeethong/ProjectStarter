/// <summary>Starts Redis once per test class.</summary>
public sealed class RedisFixture : IAsyncLifetime
{
    private readonly RedisContainer container = new RedisBuilder("redis:8-alpine").Build();

    private RedisArtifactStore? store;

    public RedisArtifactStore Store => store ?? throw new InvalidOperationException("Fixture not initialised.");

    public async ValueTask InitializeAsync()
    {
        await container.StartAsync(TestContext.Current.CancellationToken);
        store = await RedisArtifactStore.ConnectAsync(container.GetConnectionString());
    }

    public async ValueTask DisposeAsync()
    {
        if (store is not null)
        {
            await store.DisposeAsync();
        }

        await container.DisposeAsync();
    }
}

/// <summary>Integration test: needs Docker. Run with the Category=Integration filter (excluded from verify).</summary>
[Trait("Category", "Integration")]
public sealed class RedisArtifactStoreTests(RedisFixture fixture) : ArtifactStoreContract, IClassFixture<RedisFixture>
{
    protected override StoreUnderTest Subject =>
        new(fixture.Store, key => fixture.Store.ReadAsync(key, TestContext.Current.CancellationToken));
}
