/// <summary>Starts {{ 'MySQL' if mysql_engine == 'mysql' else 'MariaDB' }} once per test class and applies migrations/mysql through the image's init hook.</summary>
public sealed class MySqlFixture : IAsyncLifetime
{
    private readonly {{ container }} container = new {{ builder }}("{{ 'mysql:8.4' if mysql_engine == 'mysql' else 'mariadb:11.8' }}")
        .WithResourceMapping(new DirectoryInfo(Path.Combine(RepoPaths.Migrations, "mysql")), "/docker-entrypoint-initdb.d/")
        .Build();

    private MySqlArtifactStore? store;

    public MySqlArtifactStore Store => store ?? throw new InvalidOperationException("Fixture not initialised.");

    public async ValueTask InitializeAsync()
    {
        await container.StartAsync(TestContext.Current.CancellationToken);
        store = MySqlArtifactStore.Create(container.GetConnectionString());
    }

    public async ValueTask DisposeAsync()
    {
        if (store is not null)
        {
            await store.DisposeAsync();
        }

        await container.DisposeAsync();
    }
}

