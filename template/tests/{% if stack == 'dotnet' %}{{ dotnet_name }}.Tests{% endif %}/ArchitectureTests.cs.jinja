using Xunit;
using NetArchTest.Rules;
using {{ dotnet_name }}.Adapters;
using {{ dotnet_name }}.Application;
using {{ dotnet_name }}.Domain;

namespace {{ dotnet_name }}.Tests;

/// <summary>Layer rules from docs/adr/0001-layered-architecture.md. Project references enforce most of this at
/// compile time; these tests catch namespace leaks inside a project and document the intent.</summary>
[Trait("Category", "Architecture")]
public sealed class ArchitectureTests
{
    private const string Ns = "{{ dotnet_name }}";

    [Fact]
    public void DomainIsPure()
    {
        var result = Types.InAssembly(typeof(ExportJob).Assembly)
            .ShouldNot().HaveDependencyOnAny($"{Ns}.Application", $"{Ns}.Adapters", $"{Ns}.Bootstrap")
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Domain must not depend on outer layers. Move I/O behind a port in Application (ADR 0001).", result));
    }

    [Fact]
    public void ApplicationDoesNotDependOnAdapters()
    {
        var result = Types.InAssembly(typeof(IArtifactStore).Assembly)
            .ShouldNot().HaveDependencyOnAny($"{Ns}.Adapters", $"{Ns}.Bootstrap")
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Application talks to the outside through ports it defines; Adapters implement them (ADR 0001).", result));
    }

    [Fact]
    public void AdaptersDoNotDependOnBootstrap()
    {
        var result = Types.InAssembly(typeof(InMemoryArtifactStore).Assembly)
            .ShouldNot().HaveDependencyOn($"{Ns}.Bootstrap")
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Only Bootstrap wires dependencies together (ADR 0001).", result));
    }

    [Fact]
    public void InnerLayersHaveNoIoDependencies()
    {
        var result = Types.InAssemblies([typeof(ExportJob).Assembly, typeof(IArtifactStore).Assembly])
            .ShouldNot().HaveDependencyOnAny("System.IO", "System.Net", "System.Data", "Microsoft.EntityFrameworkCore", "Microsoft.AspNetCore")
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Domain/Application must not touch I/O. Define a port in Application and implement it in Adapters (ADR 0001, ADR 0002 #DIP).", result));
    }

    [Fact]
    public void ConcreteClassesAreSealed()
    {
        var result = Types.InAssemblies([typeof(ExportJob).Assembly, typeof(IArtifactStore).Assembly, typeof(InMemoryArtifactStore).Assembly])
            .That().AreClasses().And().AreNotAbstract()
            .Should().BeSealed()
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Concrete classes are sealed: extend behaviour through ports and composition, not inheritance (ADR 0002 #OCP #LSP).", result));
    }

    [Fact]
    public void PortsAreInterfacesInApplication()
    {
        var result = Types.InAssembly(typeof(InMemoryArtifactStore).Assembly)
            .That().AreInterfaces()
            .Should().NotBePublic()
            .GetResult();

        Assert.True(result.IsSuccessful, Explain("Ports belong to Application, which owns the abstraction; Adapters only implement them (ADR 0002 #DIP #ISP).", result));
    }

    private static string Explain(string rule, NetArchTest.Rules.TestResult result) =>
        $"{rule} Offending types: {string.Join(", ", result.FailingTypeNames ?? [])}";
}
