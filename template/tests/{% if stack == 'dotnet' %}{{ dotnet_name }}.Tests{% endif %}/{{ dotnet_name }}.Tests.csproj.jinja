<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit.v3" />
{%- if http_api %}
    <PackageReference Include="Microsoft.Playwright" />
{%- endif %}
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
{%- if mysql_engine %}
    <PackageReference Include="Testcontainers.{{ 'MySql' if mysql_engine == 'mysql' else 'MariaDb' }}" />
{%- endif %}
{%- if 'postgres' in datastores %}
    <PackageReference Include="Testcontainers.PostgreSql" />
{%- endif %}
{%- if 'redis' in datastores %}
    <PackageReference Include="Testcontainers.Redis" />
{%- endif %}
  </ItemGroup>
{%- if http_api %}
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
{%- endif %}
  <ItemGroup>
    <ProjectReference Include="..\..\src\{{ dotnet_name }}.Bootstrap\{{ dotnet_name }}.Bootstrap.csproj" />
  </ItemGroup>
</Project>
