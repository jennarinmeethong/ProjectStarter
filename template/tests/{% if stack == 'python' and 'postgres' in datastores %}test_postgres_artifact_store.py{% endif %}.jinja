from collections.abc import Iterator
from pathlib import Path

import psycopg
import pytest
from testcontainers.community.postgres import PostgresContainer
from tests.artifact_store_contract import ArtifactStoreContract, StoreUnderTest

from {{ package_name }}.adapters.postgres_artifact_store import PostgresArtifactStore

pytestmark = pytest.mark.integration

MIGRATIONS = Path(__file__).resolve().parent.parent / "migrations"


@pytest.fixture(scope="module")
def database_url() -> Iterator[str]:
    with PostgresContainer("postgres:17-alpine", driver=None) as postgres:
        url = postgres.get_connection_url()
        # Same order the image's init hook (and compose.yaml) uses: sorted file names.
        with psycopg.connect(url, autocommit=True) as connection:
            for migration in sorted(MIGRATIONS.glob("*.sql")):
                connection.execute(migration.read_text(encoding="utf-8").encode())
        yield url


class TestPostgresArtifactStore(ArtifactStoreContract):
    @pytest.fixture
    def subject(self, database_url: str) -> Iterator[StoreUnderTest]:
        store = PostgresArtifactStore.from_url(database_url)
        yield StoreUnderTest(store=store, read=store.read)
        store.close()
