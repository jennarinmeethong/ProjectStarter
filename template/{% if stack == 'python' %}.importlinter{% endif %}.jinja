# Guardrail config (protected). See docs/adr/0001-layered-architecture.md.
[importlinter]
root_package = {{ package_name }}
{%- if datastores or serve_http %}
include_external_packages = True
{%- endif %}

[importlinter:contract:layers]
name = Layers point inward: bootstrap > adapters > application > domain (ADR 0001)
type = layers
layers =
    {{ package_name }}.bootstrap
    {{ package_name }}.adapters
    {{ package_name }}.application
    {{ package_name }}.domain
{%- if datastores %}

[importlinter:contract:drivers]
name = Datastore drivers only in adapters; bootstrap passes connection settings (ADR 0003)
type = forbidden
source_modules =
    {{ package_name }}.domain
    {{ package_name }}.application
    {{ package_name }}.bootstrap
{%- if frontend == 'ssr' %}
    {{ package_name }}.adapters.web
{%- endif %}
forbidden_modules =
{%- if 'cosmosdb' in datastores %}
    azure.cosmos
{%- endif %}
{%- if 'dynamodb' in datastores or 's3' in datastores %}
    boto3
    botocore
{%- endif %}
{%- if 'mongodb' in datastores %}
    pymongo
    bson
{%- endif %}
{%- if 'sqlserver' in datastores %}
    mssql_python
{%- endif %}
{%- if mysql_engine %}
    pymysql
{%- endif %}
{%- if 'oracle' in datastores %}
    oracledb
{%- endif %}
{%- if 'postgres' in datastores %}
    psycopg
{%- endif %}
{%- if 'redis' in datastores %}
    redis
{%- endif %}
allow_indirect_imports = True
{%- endif %}
{%- if serve_http %}

[importlinter:contract:web]
name = Web framework{% if frontend == 'ssr' %} and template engine{% endif %} only in adapters: domain and application never see HTTP types (ADR 0001{% if frontend == 'ssr' %}, ADR 0005{% endif %})
type = forbidden
source_modules =
    {{ package_name }}.domain
    {{ package_name }}.application
forbidden_modules =
    fastapi
    starlette
    uvicorn
{%- if frontend == 'ssr' %}
    jinja2
{%- endif %}
allow_indirect_imports = True
{%- endif %}
