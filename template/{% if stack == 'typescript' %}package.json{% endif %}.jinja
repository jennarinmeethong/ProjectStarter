{
  "name": "{{ project_name | lower }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "tsx src/bootstrap/main.ts",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "verify:fast": "npm run typecheck && npm run lint && npm run arch",
    "verify": "npm run verify:fast && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "~4.2.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
