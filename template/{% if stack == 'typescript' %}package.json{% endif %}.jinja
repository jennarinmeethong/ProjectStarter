{%- set deps = [] -%}
{%- if http_api %}{% set _ = deps.append('"@hono/node-server": "^2.1.0"') %}{% set _ = deps.append('"hono": "^4.13.0"') %}{% endif -%}
{%- if 'postgres' in datastores %}{% set _ = deps.append('"pg": "^8.20.0"') %}{% endif -%}
{%- if mysql_engine %}{% set _ = deps.append('"mysql2": "^3.20.0"') %}{% endif -%}
{%- if 'sqlserver' in datastores %}{% set _ = deps.append('"mssql": "^12.7.0"') %}{% endif -%}
{%- if 'oracle' in datastores %}{% set _ = deps.append('"oracledb": "^26.0.0"') %}{% endif -%}
{%- if 'mongodb' in datastores %}{% set _ = deps.append('"mongodb": "^7.0.0"') %}{% endif -%}
{%- if 'dynamodb' in datastores %}{% set _ = deps.append('"@aws-sdk/client-dynamodb": "^3.1000.0"') %}{% endif -%}
{%- if 'cosmosdb' in datastores %}{% set _ = deps.append('"@azure/cosmos": "^4.9.0"') %}{% endif -%}
{%- if 's3' in datastores %}{% set _ = deps.append('"@aws-sdk/client-s3": "^3.1000.0"') %}{% endif -%}
{%- if frontend == 'nextjs' %}{% set _ = deps.append('"next": "^16.2.0"') %}{% endif -%}
{%- if frontend == 'react-native' %}{% set _ = deps.append('"@expo/metro-runtime": "^58.0.0"') %}{% set _ = deps.append('"expo": "^58.0.0"') %}{% endif -%}
{%- if frontend in ['react', 'nextjs', 'react-native'] %}{% set _ = deps.append('"react": "^19.3.0"') %}{% set _ = deps.append('"react-dom": "^19.3.0"') %}{% endif -%}
{%- if frontend == 'react-native' %}{% set _ = deps.append('"react-native": "^0.88.0"') %}{% set _ = deps.append('"react-native-web": "^0.21.0"') %}{% endif -%}
{%- if frontend == 'vue' %}{% set _ = deps.append('"vue": "^3.5.0"') %}{% endif -%}
{%- if frontend == 'angular' %}{% for p in ['common', 'compiler', 'core', 'platform-browser'] %}{% set _ = deps.append('"@angular/' ~ p ~ '": "^22.0.0"') %}{% endfor %}{% set _ = deps.append('"rxjs": "^7.8.0"') %}{% set _ = deps.append('"tslib": "^2.8.0"') %}{% endif -%}
{%- if 'redis' in datastores %}{% set _ = deps.append('"redis": "^6.1.0"') %}{% endif -%}
{%- set excludes = [] -%}
{%- if datastores %}{% set _ = excludes.append(' --exclude \\"**/*.int.test.ts\\"') %}{% endif -%}
{%- if http_api %}{% set _ = excludes.append(' --exclude \\"e2e/**\\"') %}{% endif -%}
{%- if frontend != 'none' %}{% set _ = excludes.append(' --exclude \\"e2e-ui/**\\"') %}{% endif -%}
{%- if frontend == 'angular' %}{% set _ = excludes.append(' --exclude \\"src/ui/**\\"') %}{% endif -%}
{
  "name": "{{ project_name | lower }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
{%- if frontend == 'react-native' %}
  "main": "index.ts",
{%- endif %}
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "tsx src/bootstrap/main.ts",
{%- if frontend in ['react', 'vue'] %}
    "dev": "vite",
    "build": "vite build",
{%- elif frontend == 'nextjs' %}
    "dev": "next dev",
    "build": "next build",
{%- elif frontend == 'angular' %}
    "dev": "ng serve --configuration development",
    "build": "ng build",
{%- elif frontend == 'react-native' %}
    "dev": "expo start",
    "build": "expo export --platform web --output-dir dist",
{%- endif %}
{%- if frontend != 'none' %}
    "test:ui": "playwright test --config playwright.ui.config.ts",
{%- endif %}
    "typecheck": "{{ 'vue-tsc' if frontend == 'vue' else 'tsc' }}",
    "lint": "eslint --max-warnings=0 .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run{{ excludes | join('') }}{% if frontend == 'angular' %} && ng test --watch=false{% endif %}",
{%- if datastores %}
    "test:integration": "vitest run --testTimeout=60000 .int.test.ts",
{%- endif %}
{%- if http_api %}
    "test:e2e": "playwright test",
{%- endif %}
    "mutation": "stryker run",
    "verify:fast": "npm run typecheck && npm run lint && npm run arch",
    "verify": "npm run verify:fast && npm test"
  },
{%- if deps %}
  "dependencies": {
    {{ deps | join(',\n    ') }}
  },
{%- endif %}
  "devDependencies": {
{%- if frontend != 'none' %}
    "@axe-core/playwright": "^4.11.0",
{%- endif %}
{%- if frontend == 'angular' %}
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
{%- endif %}
{%- if frontend in ['react', 'nextjs', 'react-native'] %}
    "@eslint-react/eslint-plugin": "^5.0.0",
{%- endif %}
{%- if frontend == 'nextjs' %}
    "@next/eslint-plugin-next": "^16.2.0",
{%- endif %}
    "@eslint/js": "^10.0.1",
{%- if http_api or frontend != 'none' %}
    "@playwright/test": "^1.64.0",
{%- endif %}
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
{%- if 'mongodb' in datastores %}
    "@testcontainers/mongodb": "^12.2.0",
{%- endif %}
{%- if 'sqlserver' in datastores %}
    "@testcontainers/mssqlserver": "^12.2.0",
{%- endif %}
{%- if mysql_engine %}
    "@testcontainers/mysql": "^12.0.1",
{%- endif %}
{%- if 'oracle' in datastores %}
    "@testcontainers/oraclefree": "^12.2.0",
{%- endif %}
{%- if 'postgres' in datastores %}
    "@testcontainers/postgresql": "^12.0.1",
{%- endif %}
{%- if 'redis' in datastores %}
    "@testcontainers/redis": "^12.0.1",
{%- endif %}
{%- if frontend in ['react', 'nextjs', 'react-native'] %}
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
{%- endif %}
{%- if 'sqlserver' in datastores %}
    "@types/mssql": "^12.3.0",
{%- endif %}
    "@types/node": "^24.0.0",
{%- if 'oracle' in datastores %}
    "@types/oracledb": "^26.0.0",
{%- endif %}
{%- if 'postgres' in datastores %}
    "@types/pg": "^8.20.0",
{%- endif %}
{%- if frontend in ['react', 'nextjs', 'react-native'] %}
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
{%- endif %}
{%- if frontend == 'react' %}
    "@vitejs/plugin-react": "^6.0.0",
{%- endif %}
{%- if frontend == 'vue' %}
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
{%- endif %}
{%- if frontend == 'angular' %}
    "angular-eslint": "^22.0.0",
{%- endif %}
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
{%- if frontend in ['react', 'nextjs'] %}
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
{%- endif %}
{%- if frontend in ['react', 'nextjs', 'react-native'] %}
    "eslint-plugin-react-hooks": "^7.0.0",
{%- endif %}
    "eslint-plugin-sonarjs": "~4.2.2",
{%- if frontend == 'vue' %}
    "eslint-plugin-vue": "^10.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.0",
{%- endif %}
    "fast-check": "^4.10.2",
{%- if frontend == 'vue' %}
    "globals": "^16.0.0",
{%- endif %}
{%- if frontend != 'none' %}
    "jsdom": "^27.0.0",
{%- endif %}
{%- if 'dynamodb' in datastores or 'cosmosdb' in datastores or 's3' in datastores %}
    "testcontainers": "^12.2.0",
{%- endif %}
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
{%- if frontend in ['react', 'vue'] %}
    "vite": "^8.0.0",
{%- endif %}
    "vitest": "^5.1.0"{% if frontend == 'vue' %},
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"{% endif %}
  }
}
