{%- set deps = [] -%}
{%- if http_api %}{% set _ = deps.append('"@hono/node-server": "^2.1.0"') %}{% set _ = deps.append('"hono": "^4.13.0"') %}{% endif -%}
{%- if 'postgres' in datastores %}{% set _ = deps.append('"pg": "^8.20.0"') %}{% endif -%}
{%- if frontend == 'react' %}{% set _ = deps.append('"react": "^19.2.0"') %}{% set _ = deps.append('"react-dom": "^19.2.0"') %}{% endif -%}
{%- if 'redis' in datastores %}{% set _ = deps.append('"redis": "^6.1.0"') %}{% endif -%}
{%- set excludes = [] -%}
{%- if datastores %}{% set _ = excludes.append(' --exclude \\"**/*.int.test.ts\\"') %}{% endif -%}
{%- if http_api %}{% set _ = excludes.append(' --exclude \\"e2e/**\\"') %}{% endif -%}
{%- if frontend != 'none' %}{% set _ = excludes.append(' --exclude \\"e2e-ui/**\\"') %}{% endif -%}
{
  "name": "{{ project_name | lower }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "tsx src/bootstrap/main.ts",
{%- if frontend == 'react' %}
    "dev": "vite",
    "build": "vite build",
    "test:ui": "playwright test --config playwright.ui.config.ts",
{%- endif %}
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run{{ excludes | join('') }}",
{%- if datastores %}
    "test:integration": "vitest run --testTimeout=60000 .int.test.ts",
{%- endif %}
{%- if http_api %}
    "test:e2e": "playwright test",
{%- endif %}
    "verify:fast": "npm run typecheck && npm run lint && npm run arch",
    "verify": "npm run verify:fast && npm test"
  },
{%- if deps %}
  "dependencies": {
    {{ deps | join(',\n    ') }}
  },
{%- endif %}
  "devDependencies": {
{%- if frontend == 'react' %}
    "@axe-core/playwright": "^4.11.0",
    "@eslint-react/eslint-plugin": "^5.0.0",
{%- endif %}
    "@eslint/js": "^10.0.1",
{%- if http_api or frontend != 'none' %}
    "@playwright/test": "^1.64.0",
{%- endif %}
{%- if 'postgres' in datastores %}
    "@testcontainers/postgresql": "^12.0.1",
{%- endif %}
{%- if 'redis' in datastores %}
    "@testcontainers/redis": "^12.0.1",
{%- endif %}
{%- if frontend == 'react' %}
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
{%- endif %}
    "@types/node": "^24.0.0",
{%- if 'postgres' in datastores %}
    "@types/pg": "^8.20.0",
{%- endif %}
{%- if frontend == 'react' %}
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
{%- endif %}
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
{%- if frontend == 'react' %}
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.0.0",
{%- endif %}
    "eslint-plugin-sonarjs": "~4.2.2",
    "fast-check": "^4.10.2",
{%- if frontend == 'react' %}
    "jsdom": "^27.0.0",
{%- endif %}
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
{%- if frontend == 'react' %}
    "vite": "^8.0.0",
{%- endif %}
    "vitest": "^5.1.0"
  }
}
