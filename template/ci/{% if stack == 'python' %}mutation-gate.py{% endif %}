"""Fail when the domain mutation score drops below THRESHOLD (mutmut has no break option).

Run after `uv run mutmut run && uv run mutmut export-cicd-stats`; reads mutants/mutmut-cicd-stats.json.
"""

import json
import sys
from pathlib import Path

THRESHOLD = 99.0  # percent of mutants the tests must kill; raising it is fine, lowering it needs an owner


def main() -> int:
    stats = json.loads(Path("mutants/mutmut-cicd-stats.json").read_text(encoding="utf-8"))
    killed = int(stats["killed"]) + int(stats["timeout"])
    missed = int(stats["survived"]) + int(stats["no_tests"]) + int(stats["suspicious"])
    tested = killed + missed
    if tested == 0:
        print("mutation gate: no mutants were tested; check [tool.mutmut] in pyproject.toml")
        return 1
    score = 100.0 * killed / tested
    print(f"mutation score {score:.2f}% ({killed} killed, {missed} missed; threshold {THRESHOLD}%)")
    if score < THRESHOLD:
        print("surviving mutants: uv run mutmut results; inspect one: uv run mutmut show <name>")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
