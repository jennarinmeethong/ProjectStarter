#!/usr/bin/env bash
# ci/dast.sh — run the image hardened (read-only, no capabilities), wait for /healthz, then scan the running
# service with the OWASP ZAP baseline (passive) scan. Rules and their FAIL/IGNORE levels: .zap/rules.tsv.
# Usage: ci/dast.sh <image> [--smoke|--full]
#        --smoke: only check that the container starts and answers /healthz
#        --full:  the full (active) scan, run by the release check (.github/workflows/release-check.yml). It attacks
#                 the service, reports warnings and fails only on FAIL-level rules; promote a rule to FAIL in
#                 .zap/rules.tsv once the team decides it matters. Capped by DAST_SPIDER_MINUTES (default 1) and
#                 DAST_MAX_MINUTES (default 10).
#        DAST_PATH=/ ci/dast.sh <image>     start the scan at / instead of /healthz (web UI images)
# See docs/security/owasp.md.
set -euo pipefail

image="${1:?usage: ci/dast.sh <image> [--smoke|--full]}"
mode="${2:-scan}"
case "$mode" in scan | --smoke | --full) ;; *) echo "dast: unknown option '$mode'" >&2; exit 2 ;; esac
zap="zaproxy/zap-stable:2.17.0"
id="dast-$$-$RANDOM"
net="$id-net"
app="$id-app"
work=$(mktemp -d)
export MSYS_NO_PATHCONV=1   # Git Bash on Windows: keep container paths as written

cleanup() {
  docker rm -f "$app" >/dev/null 2>&1 || true
  docker network rm "$net" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

docker network create "$net" >/dev/null
docker run -d --name "$app" --network "$net" \
  --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true "$image" >/dev/null

# The app image carries no HTTP tools, so probe it from the ZAP image on the same network.
ready=0
for _ in $(seq 1 60); do
  if docker run --rm --network "$net" --entrypoint curl "$zap" -fsS "http://$app:8080/healthz" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [ "$ready" -ne 1 ]; then
  echo "dast: the container did not answer /healthz within 60s. Logs:" >&2
  docker logs "$app" >&2 || true
  exit 1
fi
echo "dast: container healthy (read-only, no capabilities)"
[ "$mode" = "--smoke" ] && exit 0

# ZAP runs as uid 1000 and writes into its work directory, so give it a writable copy of the rules.
cp .zap/rules.tsv "$work/rules.tsv"
chmod -R a+rwX "$work"
host_work=$(cd "$work" && (pwd -W 2>/dev/null || pwd))
# Start at /healthz by default: several header rules skip 4xx/5xx responses, so the scan needs a 200 to
# judge. A web UI sets DAST_PATH=/ so the HTML page and its assets are scanned too.
target="http://$app:8080${DAST_PATH:-/healthz}"
if [ "$mode" = "--full" ]; then
  # Active rules not listed in rules.tsv default to WARN; -I reports them without failing the release check.
  docker run --rm --network "$net" -v "$host_work:/zap/wrk:rw" "$zap" \
    zap-full-scan.py -t "$target" -c rules.tsv -m "${DAST_SPIDER_MINUTES:-1}" -T "${DAST_MAX_MINUTES:-10}" -I -s
  exit
fi
# Warnings fail the baseline scan too (no -I): every rule is either fixed or explicitly IGNOREd with a reason.
docker run --rm --network "$net" -v "$host_work:/zap/wrk:rw" "$zap" \
  zap-baseline.py -t "$target" -c rules.tsv -m 1 -s
