#!/usr/bin/env bash
# ci/check-dockerfile.sh — rules hadolint cannot express. See docs/security/owasp.md.
#   1. The final stage sets USER, and that user is not root (hadolint only flags an explicit root).
#   2. The Dockerfile is multi-stage (build tools stay out of the runtime image).
# Usage: ci/check-dockerfile.sh [Dockerfile]
set -euo pipefail

file="${1:-Dockerfile}"
status=0

# Lines of the last stage only: everything after the last FROM.
last_stage=$(awk 'toupper($1) == "FROM" { buf = "" } { buf = buf $0 "\n" } END { printf "%s", buf }' "$file")
last_user=$(printf '%s' "$last_stage" | awk 'toupper($1) == "USER" { u = $2 } END { print u }')

if [ -z "$last_user" ]; then
  echo "$file: the final stage has no USER instruction. Run as a non-root user (docs/security/owasp.md)." >&2
  status=1
elif [[ "$last_user" =~ ^(root|0)(:.*)?$ ]]; then
  echo "$file: the final stage runs as '$last_user'. Run as a non-root user (docs/security/owasp.md)." >&2
  status=1
fi

stages=$(grep -ciE '^[[:space:]]*FROM[[:space:]]' "$file" || true)
if [ "$stages" -lt 2 ]; then
  echo "$file: use a multi-stage build so build tools and dev dependencies stay out of the runtime image." >&2
  status=1
fi

[ "$status" -eq 0 ] && echo "check-dockerfile: OK"
exit "$status"
