#!/usr/bin/env bash
# ci/guardrail-ratchet.sh — fail if escape hatches increase, tests are deleted or skipped,
# or type strictness is loosened, compared with the base branch.
# Usage: ci/guardrail-ratchet.sh [base-ref]   (default: origin/main)
set -euo pipefail

base_ref="${1:-origin/main}"
base=$(git merge-base "$base_ref" HEAD)

src_specs=({% for g in stk.src_globs %}':(glob)**/{{ g }}' {% endfor %})
test_specs=({% for g in stk.test_globs %}':(glob)**/{{ g }}' {% endfor %})
patterns=({% for p in stk.ratchet_patterns %}'{{ p }}' {% endfor %})

count() { # count <regex> <rev>
  { git grep -E -- "$1" "$2" -- "${src_specs[@]}" || true; } | wc -l | tr -d ' '
}

status=0
for pat in "${patterns[@]}"; do
  before=$(count "$pat" "$base"); after=$(count "$pat" HEAD)
  if [ "$after" -gt "$before" ]; then
    echo "Escape hatch increased: '$pat' ($before -> $after). Fix the cause instead; see AGENTS.md." >&2
    status=1
  fi
done

if git diff --diff-filter=D --name-only "$base" HEAD -- "${test_specs[@]}" | grep -q .; then
  echo "Test files deleted:" >&2
  git diff --diff-filter=D --name-only "$base" HEAD -- "${test_specs[@]}" >&2
  status=1
fi

if git diff "$base" HEAD -- "${test_specs[@]}" | grep -qE '^\+.*({{ stk.skip_regex }})'; then
  echo "Skipped/focused tests added. Fix or delete the test with owner approval instead." >&2
  status=1
fi
{%- if stack != 'typescript' and (frontend == 'ssr' or (stack == 'rust' and http_api)) %}

# Playwright specs are TypeScript whatever the stack's language.
spec_specs=({% if frontend == 'ssr' %}':(glob)e2e-ui/*.spec.ts' {% endif %}{% if stack == 'rust' and http_api %}':(glob)e2e/*.spec.ts' {% endif %})
if git diff --diff-filter=D --name-only "$base" HEAD -- "${spec_specs[@]}" | grep -q .; then
  echo "Playwright specs deleted:" >&2
  git diff --diff-filter=D --name-only "$base" HEAD -- "${spec_specs[@]}" >&2
  status=1
fi
if git diff "$base" HEAD -- "${spec_specs[@]}" | grep -qE '^\+.*\b(test|describe)\.(skip|only|fixme)\('; then
  echo "Skipped/focused Playwright specs added. Fix or delete the test with owner approval instead." >&2
  status=1
fi
{%- endif %}
{%- if sql_store %}

# Migrations are append-only: a merged migration has already run somewhere (docs/adr/0003-datastores.md).
if git diff --diff-filter=MDR --name-only "$base" HEAD -- migrations/ | grep -q .; then
  echo "Existing migrations were edited, renamed or deleted. Add a new numbered migration instead:" >&2
  git diff --diff-filter=MDR --name-only "$base" HEAD -- migrations/ >&2
  status=1
fi
{%- endif %}

# Strictness must not be loosened.
{%- if stack == 'typescript' %}
node -e '
const c = JSON.parse(require("child_process").execSync("npx tsc --showConfig").toString()).compilerOptions;
const need = ["strict", "noUncheckedIndexedAccess", "exactOptionalPropertyTypes"];
const bad = need.filter((k) => c[k] !== true);
if (bad.length) { console.error("tsconfig strictness loosened: " + bad.join(", ")); process.exit(1); }
' || status=1
{%- elif stack == 'python' %}
grep -Eq '"typeCheckingMode"[[:space:]]*:[[:space:]]*"strict"' pyrightconfig.json \
  || { echo "pyright strict mode was turned off in pyrightconfig.json" >&2; status=1; }
{%- elif stack == 'go' %}
grep -Eq '^[[:space:]]*default:[[:space:]]*standard' .golangci.yml   || { echo ".golangci.yml no longer enables the standard linter set" >&2; status=1; }
for linter in depguard forbidigo gosec gochecksumtype wrapcheck nolintlint; do
  grep -Eq "^[[:space:]]*-[[:space:]]+$linter([[:space:]]|$)" .golangci.yml     || { echo ".golangci.yml no longer enables $linter" >&2; status=1; }
done
{%- elif stack == 'rust' %}
for rule in 'unsafe_code = "forbid"' 'pedantic = ' 'unwrap_used = "deny"' 'allow_attributes = "deny"' 'wildcard_enum_match_arm = "deny"' 'disallowed_methods = "deny"'; do
  grep -qF "$rule" Cargo.toml || { echo "Cargo.toml [workspace.lints] no longer contains: $rule" >&2; status=1; }
done
for crate in domain application adapters bootstrap; do
  grep -Eq '^workspace[[:space:]]*=[[:space:]]*true' "crates/$crate/Cargo.toml"     || { echo "crates/$crate/Cargo.toml no longer inherits [lints] from the workspace" >&2; status=1; }
done
{%- else %}
for prop in '<Nullable>enable</Nullable>' '<TreatWarningsAsErrors>true</TreatWarningsAsErrors>'; do
  grep -q "$prop" Directory.Build.props \
    || { echo "Directory.Build.props no longer contains $prop" >&2; status=1; }
done
{%- endif %}

[ "$status" -eq 0 ] && echo "guardrail-ratchet: OK"
exit "$status"
