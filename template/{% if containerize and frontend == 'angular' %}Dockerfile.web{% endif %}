# syntax=docker/dockerfile:1
# Web UI image: the Angular production build served by unprivileged nginx with a strict CSP (nginx.conf).
# Checked by hadolint and ci/check-dockerfile.sh like the main Dockerfile.

FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY angular.json tsconfig.json tsconfig.app.json ./
COPY src ./src
RUN npx ng build

FROM nginxinc/nginx-unprivileged:1.31-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/browser /usr/share/nginx/html
EXPOSE 8080
# Numeric UID of the image's `nginx` user.
USER 101:101
