{% if 'cosmosdb' in datastores %}import { CosmosArtifactStore } from "../adapters/cosmos-artifact-store.ts";
{% endif %}{% if 'dynamodb' in datastores %}import { DynamoArtifactStore } from "../adapters/dynamo-artifact-store.ts";
{% endif %}import { InMemoryArtifactStore } from "../adapters/in-memory-artifact-store.ts";
{%- if 'mongodb' in datastores %}
import { MongoArtifactStore } from "../adapters/mongo-artifact-store.ts";
{%- endif %}
{%- if 'postgres' in datastores %}
import { PostgresArtifactStore } from "../adapters/postgres-artifact-store.ts";
{%- endif %}
{%- if mysql_engine %}
import { MySqlArtifactStore } from "../adapters/mysql-artifact-store.ts";
{%- endif %}
{%- if 'sqlserver' in datastores %}
import { SqlServerArtifactStore } from "../adapters/sqlserver-artifact-store.ts";
{%- endif %}
{%- if 'redis' in datastores %}
import { RedisArtifactStore } from "../adapters/redis-artifact-store.ts";
{%- endif %}
{%- if 's3' in datastores %}
import { S3ArtifactStore } from "../adapters/s3-artifact-store.ts";
{%- endif %}
{%- if http_api %}
import { serve } from "@hono/node-server";
import { createHttpApp } from "../adapters/http/app.ts";
import type { ArtifactStore } from "../application/complete-export.ts";
{%- else %}
import { completeExportUseCase, type ArtifactStore } from "../application/complete-export.ts";
import { startExport } from "../domain/export-job.ts";
{%- endif %}

interface OpenStore {
  readonly store: ArtifactStore;
  readonly close: () => Promise<void>;
}

/** Bootstrap is the only place that reads configuration; adapters receive plain values. */
function openStore(): Promise<OpenStore> {
{%- if 'postgres' in datastores %}
  const databaseUrl = process.env.DATABASE_URL;
  if (databaseUrl) {
    const store = PostgresArtifactStore.fromUrl(databaseUrl);
    return Promise.resolve({ store, close: () => store.close() });
  }
{%- endif %}
{%- if mysql_engine %}
  const mysqlUrl = process.env.MYSQL_URL;
  if (mysqlUrl) {
    const store = MySqlArtifactStore.fromUrl(mysqlUrl);
    return Promise.resolve({ store, close: () => store.close() });
  }
{%- endif %}
{%- if 'sqlserver' in datastores %}
  const sqlServerUrl = process.env.SQLSERVER_URL;
  if (sqlServerUrl) {
    return SqlServerArtifactStore.connect(sqlServerUrl).then((store) => ({ store, close: () => store.close() }));
  }
{%- endif %}
{%- if 'mongodb' in datastores %}
  const mongoUrl = process.env.MONGODB_URL;
  if (mongoUrl) {
    return MongoArtifactStore.connect(mongoUrl).then((store) => ({ store, close: () => store.close() }));
  }
{%- endif %}
{%- if 'cosmosdb' in datastores %}
  const cosmosEndpoint = process.env.COSMOS_ENDPOINT;
  if (cosmosEndpoint) {
    const settings = {
      endpoint: cosmosEndpoint,
      key: process.env.COSMOS_KEY ?? "",
      database: process.env.COSMOS_DATABASE ?? "app",
      createIfMissing: process.env.COSMOS_CREATE_IF_MISSING === "true",
    };
    return CosmosArtifactStore.connect(settings).then((store) => ({ store, close: () => store.close() }));
  }
{%- endif %}
{%- if 'dynamodb' in datastores %}
  const dynamoTable = process.env.DYNAMODB_TABLE;
  if (dynamoTable) {
    const store = DynamoArtifactStore.create({ table: dynamoTable, endpoint: process.env.DYNAMODB_ENDPOINT });
    return Promise.resolve({ store, close: () => store.close() });
  }
{%- endif %}
{%- if 's3' in datastores %}
  const s3Bucket = process.env.S3_BUCKET;
  if (s3Bucket) {
    const store = S3ArtifactStore.create({ bucket: s3Bucket, endpoint: process.env.S3_ENDPOINT });
    return Promise.resolve({ store, close: () => store.close() });
  }
{%- endif %}
{%- if 'redis' in datastores %}
  const redisUrl = process.env.REDIS_URL;
  if (redisUrl) {
    return RedisArtifactStore.connect(redisUrl).then((store) => ({ store, close: () => store.close() }));
  }
{%- endif %}
  return Promise.resolve({ store: new InMemoryArtifactStore(), close: () => Promise.resolve() });
}

{%- if http_api %}

const { store, close } = await openStore();
// Loopback by default; the container image sets HOST=0.0.0.0 explicitly.
const hostname = process.env.HOST ?? "127.0.0.1";
const port = Number(process.env.PORT ?? "8080");
const server = serve({ fetch: createHttpApp(store).fetch, hostname, port }, (info) => {
  console.log(`listening on http://${info.address}:${String(info.port)}`);
});

// Graceful shutdown: stop accepting connections, finish in-flight requests, then release the store.
for (const signal of ["SIGINT", "SIGTERM"] as const) {
  process.once(signal, () => {
    server.close(() => {
      void close();
    });
  });
}
{%- else %}

const { store, close } = await openStore();
try {
  const job = startExport({ kind: "queued", id: "demo" });
  const ready = await completeExportUseCase(store, job, "id,name\n1,demo\n");
  console.log(`${ready.id} -> ${ready.artifactKey}`);
} finally {
  await close();
}
{%- endif %}
