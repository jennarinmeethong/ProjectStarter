<Project>
  <ItemGroup>
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
{%- if http_api %}
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.0" />
{%- endif %}
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
{%- if mysql_engine %}
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Testcontainers.{{ 'MySql' if mysql_engine == 'mysql' else 'MariaDb' }}" Version="4.16.0" />
{%- endif %}
{%- if 'postgres' in datastores %}
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
{%- endif %}
{%- if 'redis' in datastores %}
    <PackageVersion Include="StackExchange.Redis" Version="3.4.31" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
{%- endif %}
  </ItemGroup>
</Project>
