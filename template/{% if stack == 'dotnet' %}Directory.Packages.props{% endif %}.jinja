<Project>
  <ItemGroup>
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
{%- if http_api %}
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.0" />
{%- endif %}
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
{%- if 'cosmosdb' in datastores %}
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.4" />
    <!-- The Cosmos SDK requires an explicit Newtonsoft.Json reference even when it serialises with System.Text.Json. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
{%- endif %}
{%- if 'dynamodb' in datastores %}
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.110.3" />
{%- endif %}
{%- if 's3' in datastores %}
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
{%- endif %}
{%- if 'dynamodb' in datastores or 'cosmosdb' in datastores or 's3' in datastores or 'oracle' in datastores %}
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
{%- endif %}
{%- if 'mongodb' in datastores %}
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
{%- endif %}
{%- if 'oracle' in datastores %}
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <!-- ODP.NET still pulls System.Security.Cryptography.Pkcs 8.0.1 (GHSA-846f-f764-76mx); pin the patched one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
{%- endif %}
{%- if 'sqlserver' in datastores %}
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
{%- endif %}
{%- if mysql_engine %}
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Testcontainers.{{ 'MySql' if mysql_engine == 'mysql' else 'MariaDb' }}" Version="4.16.0" />
{%- endif %}
{%- if 'postgres' in datastores %}
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
{%- endif %}
{%- if 'redis' in datastores %}
    <PackageVersion Include="StackExchange.Redis" Version="3.4.31" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
{%- endif %}
  </ItemGroup>
</Project>
