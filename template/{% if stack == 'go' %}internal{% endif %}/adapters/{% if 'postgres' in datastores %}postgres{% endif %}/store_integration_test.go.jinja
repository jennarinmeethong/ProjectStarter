//go:build integration

// Integration test: needs Docker. Run with `go test -tags integration ./...`.
package postgres_test

import (
	"path/filepath"
	"sort"
	"testing"

	"github.com/testcontainers/testcontainers-go"
	tcpostgres "github.com/testcontainers/testcontainers-go/modules/postgres"

	"{{ go_module }}/internal/adapters/postgres"
	"{{ go_module }}/internal/adapters/storetest"
)

func TestPostgresStoreSatisfiesTheContract(t *testing.T) {
	ctx := t.Context()
	// The image's init hook applies migrations/ in file-name order, as compose.yaml does locally.
	migrations, err := filepath.Glob(filepath.Join("..", "..", "..", "migrations", "*.sql"))
	if err != nil || len(migrations) == 0 {
		t.Fatalf("no migrations found: %v", err)
	}
	sort.Strings(migrations)

	container, err := tcpostgres.Run(ctx, "postgres:17-alpine",
		tcpostgres.WithInitScripts(migrations...),
		tcpostgres.BasicWaitStrategies(),
	)
	testcontainers.CleanupContainer(t, container)
	if err != nil {
		t.Fatalf("start postgres: %v", err)
	}
	url, err := container.ConnectionString(ctx, "sslmode=disable")
	if err != nil {
		t.Fatalf("connection string: %v", err)
	}
	store, err := postgres.Open(ctx, url)
	if err != nil {
		t.Fatalf("open: %v", err)
	}
	t.Cleanup(store.Close)

	storetest.Run(t, func(*testing.T) storetest.Subject {
		return storetest.Subject{Store: store, Read: store.Read}
	})
}
