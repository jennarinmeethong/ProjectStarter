//go:build integration

// Integration test: needs Docker. Run with `go test -tags integration ./...`.
package redisstore_test

import (
	"testing"

	"github.com/testcontainers/testcontainers-go"
	tcredis "github.com/testcontainers/testcontainers-go/modules/redis"

	"{{ go_module }}/internal/adapters/redisstore"
	"{{ go_module }}/internal/adapters/storetest"
)

func TestRedisStoreSatisfiesTheContract(t *testing.T) {
	ctx := t.Context()
	container, err := tcredis.Run(ctx, "redis:8-alpine")
	testcontainers.CleanupContainer(t, container)
	if err != nil {
		t.Fatalf("start redis: %v", err)
	}
	url, err := container.ConnectionString(ctx)
	if err != nil {
		t.Fatalf("connection string: %v", err)
	}
	store, err := redisstore.Open(ctx, url)
	if err != nil {
		t.Fatalf("open: %v", err)
	}
	t.Cleanup(func() { _ = store.Close() })

	storetest.Run(t, func(*testing.T) storetest.Subject {
		return storetest.Subject{Store: store, Read: store.Read}
	})
}
