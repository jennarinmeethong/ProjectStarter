{%- if http_api %}

// Run serves the HTTP API until ctx is cancelled, then shuts down gracefully.
{%- else %}

// Run completes a demo export and prints its artifact key.
{%- endif %}
func Run(ctx context.Context, stdout io.Writer) error {
{%- if datastores %}
	store, closeStore, err := openStore(ctx)
	if err != nil {
		return err
	}
	defer closeStore()
{%- else %}
	store := inmemory.New()
{%- endif %}
{%- if http_api %}

	return serve(ctx, store, stdout)
{%- else %}

	job := domain.Start(domain.NewQueued("demo"))
	ready, err := application.CompleteExport(ctx, store, job, "id,name\n1,demo\n")
	if err != nil {
		return fmt.Errorf("demo export: %w", err)
	}
	if _, err := fmt.Fprintf(stdout, "%s -> %s\n", ready.ID(), ready.ArtifactKey()); err != nil {
		return fmt.Errorf("write output: %w", err)
	}
	return nil
{%- endif %}
}
{%- if datastores %}

// openStore picks the adapter from configuration; in-memory when nothing is configured.
func openStore(ctx context.Context) (application.ArtifactStore, func(), error) {
{%- if 'postgres' in datastores %}
	if url := os.Getenv("DATABASE_URL"); url != "" {
		store, err := postgres.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open postgres: %w", err)
		}
		return store, store.Close, nil
	}
{%- endif %}
{%- if mysql_engine %}
	if url := os.Getenv("MYSQL_URL"); url != "" {
		store, err := mysqlstore.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open mysql: %w", err)
		}
		return store, func() { _ = store.Close() }, nil
	}
{%- endif %}
{%- if 'cosmosdb' in datastores %}
	if endpoint := os.Getenv("COSMOS_ENDPOINT"); endpoint != "" {
		store, err := openCosmos(ctx, endpoint)
		if err != nil {
			return nil, nil, err
		}
		return store, func() {}, nil
	}
{%- endif %}
{%- if 'dynamodb' in datastores %}
	if table := os.Getenv("DYNAMODB_TABLE"); table != "" {
		store, err := dynamostore.Open(ctx, table, os.Getenv("DYNAMODB_ENDPOINT"))
		if err != nil {
			return nil, nil, fmt.Errorf("open dynamodb: %w", err)
		}
		return store, func() {}, nil
	}
{%- endif %}
{%- if 'mongodb' in datastores %}
	if url := os.Getenv("MONGODB_URL"); url != "" {
		store, err := mongostore.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open mongodb: %w", err)
		}
		return store, func() { _ = store.Close(context.WithoutCancel(ctx)) }, nil
	}
{%- endif %}
{%- if 'oracle' in datastores %}
	if url := os.Getenv("ORACLE_URL"); url != "" {
		store, err := oraclestore.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open oracle: %w", err)
		}
		return store, func() { _ = store.Close() }, nil
	}
{%- endif %}
{%- if 'sqlserver' in datastores %}
	if url := os.Getenv("SQLSERVER_URL"); url != "" {
		store, err := sqlserverstore.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open sqlserver: %w", err)
		}
		return store, func() { _ = store.Close() }, nil
	}
{%- endif %}
{%- if 's3' in datastores %}
	if bucket := os.Getenv("S3_BUCKET"); bucket != "" {
		store, err := s3store.Open(ctx, bucket, os.Getenv("S3_ENDPOINT"))
		if err != nil {
			return nil, nil, fmt.Errorf("open s3: %w", err)
		}
		return store, func() {}, nil
	}
{%- endif %}
{%- if 'redis' in datastores %}
	if url := os.Getenv("REDIS_URL"); url != "" {
		store, err := redisstore.Open(ctx, url)
		if err != nil {
			return nil, nil, fmt.Errorf("open redis: %w", err)
		}
		return store, func() { _ = store.Close() }, nil
	}
{%- endif %}
	return inmemory.New(), func() {}, nil
}
{%- endif %}
{%- if http_api %}

func serve(ctx context.Context, store application.ArtifactStore, stdout io.Writer) error {
	// Loopback by default; the container image sets HOST=0.0.0.0 explicitly.
	server := &http.Server{
		Addr:              net.JoinHostPort(envOr("HOST", "127.0.0.1"), envOr("PORT", "8080")),
		Handler:           httpapi.NewHandler(store),
		ReadHeaderTimeout: 5 * time.Second,
	}
	errs := make(chan error, 1)
	go func() { errs <- server.ListenAndServe() }()
	if _, err := fmt.Fprintf(stdout, "listening on http://%s\n", server.Addr); err != nil {
		return fmt.Errorf("write output: %w", err)
	}

	select {
	case err := <-errs:
		return fmt.Errorf("serve: %w", err)
	case <-ctx.Done():
		shutdownCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 10*time.Second)
		defer cancel()
		if err := server.Shutdown(shutdownCtx); err != nil {
			return fmt.Errorf("shutdown: %w", err)
		}
		return nil
	}
}

func envOr(name, fallback string) string {
	if value := os.Getenv(name); value != "" {
		return value
	}
	return fallback
}
{%- endif %}
{%- if 'cosmosdb' in datastores %}

// openCosmos reads the Cosmos DB settings. COSMOS_CREATE_IF_MISSING is for local use only.
func openCosmos(ctx context.Context, endpoint string) (*cosmosstore.Store, error) {
	database := os.Getenv("COSMOS_DATABASE")
	if database == "" {
		database = "app"
	}
	key := os.Getenv("COSMOS_KEY")
	if os.Getenv("COSMOS_CREATE_IF_MISSING") == "true" {
		if err := cosmosstore.EnsureContainer(ctx, endpoint, key, database); err != nil {
			return nil, fmt.Errorf("ensure cosmos container: %w", err)
		}
	}
	store, err := cosmosstore.Open(endpoint, key, database)
	if err != nil {
		return nil, fmt.Errorf("open cosmos db: %w", err)
	}
	return store, nil
}
{%- endif %}
