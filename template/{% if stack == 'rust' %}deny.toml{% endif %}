# Guardrail config (protected). `cargo deny check` — advisories run in CI on every PR and weekly.
[graph]
all-features = true

[advisories]
# Known vulnerabilities and yanked crates fail the check; unmaintained crates are reported.
yanked = "deny"
unmaintained = "workspace"

[licenses]
# Keep in line with the project's chosen license; add an entry only after checking compatibility.
allow = ["MIT", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BSD-2-Clause", "BSD-3-Clause", "ISC", "Unicode-3.0", "Zlib", "CC0-1.0", "MPL-2.0", "CDLA-Permissive-2.0"]
confidence-threshold = 0.9

[bans]
multiple-versions = "allow"
wildcards = "deny"
allow-wildcard-paths = true

[sources]
unknown-registry = "deny"
unknown-git = "deny"
