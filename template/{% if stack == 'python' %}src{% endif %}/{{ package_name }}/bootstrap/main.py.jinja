@contextmanager
def open_store() -> Generator[ArtifactStore, None, None]:
    """Bootstrap is the only place that reads configuration; adapters receive plain values."""
{%- if 'postgres' in datastores %}
    database_url = os.environ.get("DATABASE_URL")
    if database_url:
        postgres = PostgresArtifactStore.from_url(database_url)
        try:
            yield postgres
        finally:
            postgres.close()
        return
{%- endif %}
{%- if mysql_engine %}
    mysql_url = os.environ.get("MYSQL_URL")
    if mysql_url:
        mysql = MySqlArtifactStore.from_url(mysql_url)
        try:
            yield mysql
        finally:
            mysql.close()
        return
{%- endif %}
{%- if 'cosmosdb' in datastores %}
    cosmos_endpoint = os.environ.get("COSMOS_ENDPOINT")
    if cosmos_endpoint:
        cosmos = CosmosArtifactStore.connect(
            cosmos_endpoint,
            os.environ.get("COSMOS_KEY", ""),
            os.environ.get("COSMOS_DATABASE", "app"),
            create_if_missing=os.environ.get("COSMOS_CREATE_IF_MISSING") == "true",
        )
        try:
            yield cosmos
        finally:
            cosmos.close()
        return
{%- endif %}
{%- if 'dynamodb' in datastores %}
    dynamodb_table = os.environ.get("DYNAMODB_TABLE")
    if dynamodb_table:
        dynamo = DynamoArtifactStore.create(dynamodb_table, os.environ.get("DYNAMODB_ENDPOINT"))
        try:
            yield dynamo
        finally:
            dynamo.close()
        return
{%- endif %}
{%- if 'mongodb' in datastores %}
    mongodb_url = os.environ.get("MONGODB_URL")
    if mongodb_url:
        mongo = MongoArtifactStore.from_url(mongodb_url)
        try:
            yield mongo
        finally:
            mongo.close()
        return
{%- endif %}
{%- if 'oracle' in datastores %}
    oracle_url = os.environ.get("ORACLE_URL")
    if oracle_url:
        oracle = OracleArtifactStore.from_url(oracle_url)
        try:
            yield oracle
        finally:
            oracle.close()
        return
{%- endif %}
{%- if 'sqlserver' in datastores %}
    sqlserver_url = os.environ.get("SQLSERVER_URL")
    if sqlserver_url:
        sqlserver = SqlServerArtifactStore.from_url(sqlserver_url)
        try:
            yield sqlserver
        finally:
            sqlserver.close()
        return
{%- endif %}
{%- if 's3' in datastores %}
    s3_bucket = os.environ.get("S3_BUCKET")
    if s3_bucket:
        s3 = S3ArtifactStore.create(s3_bucket, os.environ.get("S3_ENDPOINT"))
        try:
            yield s3
        finally:
            s3.close()
        return
{%- endif %}
{%- if 'redis' in datastores %}
    redis_url = os.environ.get("REDIS_URL")
    if redis_url:
        redis = RedisArtifactStore.from_url(redis_url)
        try:
            yield redis
        finally:
            redis.close()
        return
{%- endif %}
    yield InMemoryArtifactStore()
{%- endif %}
{%- if http_api %}


def main() -> None:
    # Loopback by default; the container image sets HOST=0.0.0.0 explicitly.
    host = os.environ.get("HOST", "127.0.0.1")
    port = int(os.environ.get("PORT", "8080"))
{%- if datastores %}
    with open_store() as store:
        app = create_app(store)
        uvicorn.run(app, host=host, port=port, server_header=False, proxy_headers=False)
{%- else %}
    app = create_app(InMemoryArtifactStore())
    uvicorn.run(app, host=host, port=port, server_header=False, proxy_headers=False)
{%- endif %}
{%- else %}


def main() -> None:
{%- if datastores %}
    with open_store() as store:
        job = start_export(QueuedExport(id="demo"))
        ready = complete_export_use_case(store, job, "id,name\n1,demo\n")
{%- else %}
    store = InMemoryArtifactStore()
    job = start_export(QueuedExport(id="demo"))
    ready = complete_export_use_case(store, job, "id,name\n1,demo\n")
{%- endif %}
    print(f"{ready.id} -> {ready.artifact_key}")
{%- endif %}


if __name__ == "__main__":
    main()
