// Guardrail config (protected). Rule messages say what to do instead and link an ADR.
{% if frontend in ['react', 'nextjs', 'react-native'] -%}
import eslintReact from "@eslint-react/eslint-plugin";
{% endif -%}
import js from "@eslint/js";
{% if frontend == 'angular' -%}
import angular from "angular-eslint";
{% endif -%}
{% if frontend == 'nextjs' -%}
import nextPlugin from "@next/eslint-plugin-next";
{% endif -%}
{% if frontend in ['react', 'nextjs'] -%}
import jsxA11y from "eslint-plugin-jsx-a11y-x";
{% endif -%}
{% if frontend in ['react', 'nextjs', 'react-native'] -%}
import reactHooks from "eslint-plugin-react-hooks";
{% endif -%}
import sonarjs from "eslint-plugin-sonarjs";
{% if frontend == 'vue' -%}
import pluginVue from "eslint-plugin-vue";
import vueA11y from "eslint-plugin-vuejs-accessibility";
{% endif -%}
import tseslint from "typescript-eslint";

const ADR_LAYERS = "docs/adr/0001-layered-architecture.md";
const ADR_DESIGN = "docs/adr/0002-design-rules.md";

const noCastThroughUnknown = {
  selector: "TSAsExpression > TSAsExpression[typeAnnotation.type='TSUnknownKeyword']",
  message: `Do not cast through \`unknown\`. Decode/validate the value at the boundary instead (${ADR_LAYERS}).`,
};

// SQL injection (OWASP A03): sonarjs/sql-queries only follows clients created in the same file, so also reject
// any `.query()` / `.execute()` whose SQL is assembled from values. Pass values as parameters instead.
const ADR_DATA = "docs/adr/0003-datastores.md";
const noSqlFromStrings = [
  {
    selector: "CallExpression[callee.property.name=/^(query|execute)$/] > BinaryExpression[operator='+']",
    message: `Do not build SQL by concatenation. Use placeholders ($1, $2 ...) and pass values as parameters (${ADR_DATA}).`,
  },
  {
    selector: "CallExpression[callee.property.name=/^(query|execute)$/] > TemplateLiteral[expressions.length>0]",
    message: `Do not interpolate values into SQL. Use placeholders ($1, $2 ...) and pass values as parameters (${ADR_DATA}).`,
  },
];

// NoSQL injection (OWASP A03): operators that run JavaScript on the database server turn data into code.
// Keep filters as typed objects with plain values (ADR 0003).
const SERVER_SIDE_JS = "/^\\$(where|function|accumulator)$/";
const noServerSideJs = [
  {
    selector: `Property[key.name=${SERVER_SIDE_JS}], Property[key.value=${SERVER_SIDE_JS}]`,
    message: `Do not use $where/$function/$accumulator: they run JavaScript on the database server (${ADR_DATA}).`,
  },
];

// DynamoDB expressions and PartiQL statements carry values as placeholders (:value), never inline (ADR 0003).
const EXPRESSION_KEY = "/(Expression|Statement)$/";
const noExpressionsFromStrings = [
  {
    selector: `Property[key.name=${EXPRESSION_KEY}] > TemplateLiteral[expressions.length>0]`,
    message: `Do not interpolate values into DynamoDB expressions. Use :placeholders and ExpressionAttributeValues (${ADR_DATA}).`,
  },
  {
    selector: `Property[key.name=${EXPRESSION_KEY}] > BinaryExpression[operator='+']`,
    message: `Do not concatenate DynamoDB expressions. Use :placeholders and ExpressionAttributeValues (${ADR_DATA}).`,
  },
];

// Hidden inputs make domain/application code non-deterministic and untestable (DIP: inject them as ports).
const noHiddenInputs = [
  {
    selector: "CallExpression[callee.object.name='Date'][callee.property.name='now']",
    message: `No ambient clock in domain/application. Inject a Clock port and pass the time in (${ADR_DESIGN} #DIP).`,
  },
  {
    selector: "NewExpression[callee.name='Date'][arguments.length=0]",
    message: `No ambient clock in domain/application. Inject a Clock port and pass the time in (${ADR_DESIGN} #DIP).`,
  },
  {
    selector: "CallExpression[callee.object.name='Math'][callee.property.name='random']",
    message: `No ambient randomness in domain/application. Inject a random/id generator port (${ADR_DESIGN} #DIP).`,
  },
  {
    selector: "CallExpression[callee.object.name='crypto'][callee.property.name='randomUUID']",
    message: `No ambient id generation in domain/application. Inject an IdGenerator port (${ADR_DESIGN} #DIP).`,
  },
];

export default tseslint.config(
  { ignores: ["node_modules/", "dist/", "coverage/", "playwright-report*/", "test-results/", "*.config.*", ".dependency-cruiser.cjs", "ci/"{% if frontend == 'nextjs' %}, ".next/", "next-env.d.ts"{% endif %}{% if frontend == 'angular' %}, ".angular/"{% endif %}{% if frontend == 'react-native' %}, ".expo/", "index.ts"{% endif %}] },
  js.configs.recommended,
  ...tseslint.configs.strictTypeChecked,
  {
    languageOptions: {
      parserOptions: { projectService: true, tsconfigRootDir: import.meta.dirname },
    },
    linterOptions: { reportUnusedDisableDirectives: "error" },
    plugins: { sonarjs },
    rules: {
      "@typescript-eslint/ban-ts-comment": ["error", { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }],
      "@typescript-eslint/no-explicit-any": "error",
      "no-restricted-syntax": ["error", noCastThroughUnknown, ...noSqlFromStrings, ...noServerSideJs, ...noExpressionsFromStrings],

      // Single responsibility: when a unit outgrows these limits, split it by reason to change (ADR 0002 #SRP).
      // Cognitive complexity (how hard a function is to read) replaces cyclomatic `complexity`.
      "sonarjs/cognitive-complexity": ["error", 15],
      "max-depth": ["error", 3],
      "max-params": ["error", 4],
      "max-lines-per-function": ["error", { max: 60, skipBlankLines: true, skipComments: true }],
      "max-lines": ["error", { max: 300, skipBlankLines: true, skipComments: true }],

      // Open/closed + Liskov: every variant of a union is handled; adding a variant breaks the build, not prod.
      "@typescript-eslint/switch-exhaustiveness-check": ["error", { considerDefaultExhaustiveForUnions: false }],

      // Explicit contracts at module boundaries; immutability by default.
      "@typescript-eslint/explicit-module-boundary-types": "error",
      "@typescript-eslint/prefer-readonly": "error",
      "no-param-reassign": ["error", { props: true }],
      eqeqeq: ["error", "always"],
      "no-implicit-coercion": "error",
      "prefer-const": "error",

      // Curated SonarJS rules (ADR 0002): bug patterns and duplication that the rules above miss.
      // Only these are enabled on purpose; noisy presets push agents towards suppressions.
      "sonarjs/no-identical-functions": "error",
      "sonarjs/no-duplicate-string": ["error", { threshold: 3 }],
      "sonarjs/no-all-duplicated-branches": "error",
      "sonarjs/no-duplicated-branches": "error",
      "sonarjs/no-identical-conditions": "error",
      "sonarjs/no-identical-expressions": "error",
      "sonarjs/no-gratuitous-expressions": "error",
      "sonarjs/no-element-overwrite": "error",
      "sonarjs/no-collection-size-mischeck": "error",
      "sonarjs/no-unused-collection": "error",
      "sonarjs/no-use-of-empty-return-value": "error",
      "sonarjs/no-ignored-return": "error",
      "sonarjs/non-existent-operator": "error",
      "sonarjs/no-collapsible-if": "error",
      "sonarjs/no-redundant-boolean": "error",
      "sonarjs/no-redundant-jump": "error",
      "sonarjs/no-inverted-boolean-check": "error",
      "sonarjs/prefer-single-boolean-return": "error",
      "sonarjs/prefer-immediate-return": "error",
      "sonarjs/no-nested-conditional": "error",
      "sonarjs/no-nested-switch": "error",
      "sonarjs/no-small-switch": "error",
      "sonarjs/no-useless-catch": "error",
      "sonarjs/no-hardcoded-passwords": "error",
      "sonarjs/no-hardcoded-ip": "error",
      // SQL is built with parameters ($1, $2 ...), never by concatenating or interpolating values (ADR 0003).
      "sonarjs/sql-queries": "error",
    },
  },
  {
    // Timers in product code usually paper over ordering bugs. Use an explicit scheduler port instead.
    files: ["src/domain/**", "src/application/**"],
    ignores: ["**/*.test.ts"],
    rules: {
      "no-restricted-globals": [
        "error",
        { name: "setTimeout", message: "No timers in domain/application. Model the state or inject a scheduler port (docs/engineering/agent-principles.md #2)." },
        { name: "setInterval", message: "No timers in domain/application. Inject a scheduler port instead." },
        { name: "process", message: `No environment/process access in domain/application. Read config in bootstrap and pass it in (${ADR_DESIGN} #DIP).` },
        { name: "fetch", message: `No I/O in domain/application. Define a port in application and implement it in adapters (${ADR_LAYERS}).` },
      ],
      "no-restricted-syntax": ["error", noCastThroughUnknown, ...noSqlFromStrings, ...noServerSideJs, ...noExpressionsFromStrings, ...noHiddenInputs],
      "no-console": ["error"],
    },
  },
  {
    // Tests read best as one flat list of cases.
    files: ["**/*.test.ts", "**/*.test.tsx", "tests/**", "e2e/**", "e2e-ui/**"],
    rules: { "max-lines-per-function": "off", "max-lines": "off", "sonarjs/no-duplicate-string": "off" },
  },
{%- if frontend in ['react', 'nextjs', 'react-native'] %}
  {
    // UI adapter (ADR 0005): React correctness, hooks rules and accessibility.
    files: ["src/ui/**/*.tsx"{% if frontend == 'nextjs' %}, "src/app/**/*.tsx"{% endif %}],
    ...eslintReact.configs["recommended-type-checked"],
  },
  {
    files: ["src/ui/**/*.tsx"{% if frontend == 'nextjs' %}, "src/app/**/*.tsx"{% endif %}],
    plugins: { "react-hooks": reactHooks },
    rules: {
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "error",
    },
  },
{%- if frontend == 'react-native' %}
  {
    // React Native has no maintained a11y lint plugin for ESLint 10: require an accessible role and name on every
    // touchable and alt text on images. axe checks the web build in a real browser (e2e-ui/).
    files: ["src/ui/**/*.tsx"],
    rules: {
      "no-restricted-syntax": [
        "error",
        noCastThroughUnknown,
        ...noSqlFromStrings,
        {
          selector: "JSXOpeningElement[name.name=/^(Pressable|TouchableOpacity|TouchableHighlight|TouchableWithoutFeedback)$/]:not(:has(JSXAttribute[name.name='role']))",
          message: "Touchables need a role (for example role=\"button\") so screen readers announce them (ADR 0005).",
        },
        {
          selector: "JSXOpeningElement[name.name=/^(Pressable|TouchableOpacity|TouchableHighlight|TouchableWithoutFeedback)$/]:not(:has(JSXAttribute[name.name='aria-label']))",
          message: "Touchables need an aria-label: their accessible name (ADR 0005).",
        },
        {
          selector: "JSXOpeningElement[name.name='Image']:not(:has(JSXAttribute[name.name=/^(alt|aria-label|aria-hidden)$/]))",
          message: "Images need alt text, or aria-hidden when decorative (ADR 0005).",
        },
      ],
    },
  },
{%- else %}
  { files: ["src/ui/**/*.tsx"{% if frontend == 'nextjs' %}, "src/app/**/*.tsx"{% endif %}], ...jsxA11y.configs.strict },
{%- endif %}
{%- if frontend == 'nextjs' %}
  {
    // Next.js rules: core web vitals, no sync scripts, no raw <img> or <a> where Next has a safer primitive.
    files: ["src/app/**/*.{ts,tsx}", "src/proxy.ts"],
    plugins: { "@next/next": nextPlugin },
    rules: { ...nextPlugin.configs.recommended.rules, ...nextPlugin.configs["core-web-vitals"].rules },
  },
{%- endif %}
{%- endif %}
{%- if frontend == 'angular' %}
  {
    // UI adapter (ADR 0005): Angular rules for components; inline templates are linted as HTML below.
    files: ["src/ui/**/*.ts"],
    extends: [...angular.configs.tsRecommended],
    processor: angular.processInlineTemplates,
  },
  {
    // Templates: Angular correctness and accessibility (template-accessibility), without type information.
    files: ["src/ui/**/*.html"],
    extends: [tseslint.configs.disableTypeChecked, ...angular.configs.templateRecommended, ...angular.configs.templateAccessibility],
  },
{%- endif %}
{%- if frontend == 'vue' %}
  // UI adapter (ADR 0005): Vue correctness and accessibility. Templates are linted without type information;
  // logic belongs in the use cases, so components stay thin.
  ...pluginVue.configs["flat/recommended"].map((config) => ({ ...config, files: ["src/ui/**/*.vue"] })),
  ...vueA11y.configs["flat/recommended"].map((config) => ({ ...config, files: ["src/ui/**/*.vue"] })),
  {
    files: ["src/ui/**/*.vue"],
    ...tseslint.configs.disableTypeChecked,
    languageOptions: {
      parserOptions: { parser: tseslint.parser, extraFileExtensions: [".vue"], projectService: false },
    },
    rules: { ...tseslint.configs.disableTypeChecked.rules, "vue/no-v-html": "error" },
  },
{%- endif %}
);
