# Weekly dependency updates. Security fixes still arrive between runs via the CI dependency audit.
version: 2
updates:
  - package-ecosystem: {% if stack == 'typescript' %}npm{% elif stack == 'python' %}uv{% elif stack == 'go' %}gomod{% else %}nuget{% endif %}
    directory: /
    schedule:
      interval: weekly
    groups:
      minor-and-patch:
        update-types: [minor, patch]
{%- if containerize %}
  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
{%- endif %}
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
