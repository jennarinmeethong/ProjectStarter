name: ci
on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * 1"   # weekly: new advisories appear without code changes

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
{%- if stack == 'typescript' %}
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
{%- elif stack == 'python' %}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync --locked
{%- elif stack == 'dotnet' %}
      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json
      - run: dotnet restore
{%- elif stack == 'go' %}
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go mod download
{%- elif stack == 'rust' %}
      # rust-toolchain.toml pins the compiler, clippy and rustfmt; rustup installs them on first use.
      - uses: Swatinem/rust-cache@v2
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-deny
      - run: cargo fetch --locked
{%- endif %}
      - name: Verify (types, lint, architecture, tests)
        run: {{ cmd.verify }}
      - name: Dependency audit (known vulnerabilities)
        run: {{ cmd.audit }}
{%- if 'postgres' in datastores %}
{%- if stack != 'python' %}
      - uses: astral-sh/setup-uv@v6
{%- endif %}
      - name: SQL lint (migrations)
        run: {{ cmd.sql_lint }}
{%- endif %}
      - name: Guardrail ratchet
        if: github.event_name == 'pull_request'
        run: bash ci/guardrail-ratchet.sh origin/${{ '{{' }} github.base_ref {{ '}}' }}
{%- if datastores %}

  integration:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{%- if stack == 'typescript' %}
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
{%- elif stack == 'python' %}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync --locked
{%- elif stack == 'dotnet' %}
      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json
      - run: dotnet build
{%- elif stack == 'go' %}
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go mod download
{%- elif stack == 'rust' %}
      # rust-toolchain.toml pins the compiler, clippy and rustfmt; rustup installs them on first use.
      - uses: Swatinem/rust-cache@v2
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-deny
      - run: cargo fetch --locked
{%- endif %}
      - name: Adapter contract tests against real datastores (Testcontainers)
        run: {{ cmd.test_integration }}
{%- endif %}
{%- if http_api %}

  e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{%- if stack == 'typescript' %}
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
{%- elif stack == 'python' %}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync --locked
{%- elif stack == 'dotnet' %}
      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json
      - run: dotnet build
{%- elif stack == 'go' %}
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go mod download
{%- elif stack == 'rust' %}
      # rust-toolchain.toml pins the compiler, clippy and rustfmt; rustup installs them on first use.
      - uses: Swatinem/rust-cache@v2
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-deny
      - run: cargo fetch --locked
{%- endif %}
{%- if stack == 'rust' %}
      - uses: actions/setup-node@v4
        with:
          node-version: 24
{%- endif %}
      - name: API tests against the real server (Playwright)
        run: {{ cmd.test_e2e }}
{%- endif %}

  secrets:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Secret scan (gitleaks, full history)
        run: docker run --rm -v "$PWD:/repo" -w /repo zricethezav/gitleaks:v8.30.1 git --config .gitleaks.toml --redact --exit-code 1 /repo
{%- if containerize %}

  container:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Dockerfile lint (hadolint)
        run: docker run --rm -v "$PWD:/w" -w /w hadolint/hadolint:v2.15.1 hadolint Dockerfile
      - name: Dockerfile rules (non-root, multi-stage)
        run: bash ci/check-dockerfile.sh Dockerfile
      - name: Build image
        run: docker build -t app:ci .
{%- if http_api %}
      - name: Smoke run (hardened container answers /healthz)
        run: bash ci/dast.sh app:ci --smoke

  dast:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build image
        run: docker build -t app:ci .
      - name: OWASP ZAP baseline scan of the running container
        run: bash ci/dast.sh app:ci
{%- else %}
      - name: Smoke run
        run: docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges:true app:ci
{%- endif %}
{%- endif %}
