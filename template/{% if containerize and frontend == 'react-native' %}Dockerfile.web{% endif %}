# syntax=docker/dockerfile:1
# Web UI image: the React Native web build (Expo, react-native-web) served by unprivileged nginx with a strict CSP (nginx.conf).
# Checked by hadolint and ci/check-dockerfile.sh like the main Dockerfile.

FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY app.json index.ts tsconfig.json ./
COPY public ./public
COPY src ./src
RUN npx expo export --platform web --output-dir dist

FROM nginxinc/nginx-unprivileged:1.31-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
# Numeric UID of the image's `nginx` user.
USER 101:101
