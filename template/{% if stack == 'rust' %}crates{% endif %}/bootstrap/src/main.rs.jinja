/// The adapter chosen from configuration. Enum dispatch keeps `ArtifactStore` free of `dyn` and makes
/// every adapter explicit here.
#[derive(Clone)]
enum AnyStore {
{%- if 'cosmosdb' in datastores %}
    Cosmos(CosmosArtifactStore),
{%- endif %}
{%- if 'dynamodb' in datastores %}
    Dynamo(DynamoArtifactStore),
{%- endif %}
    InMemory(InMemoryArtifactStore),
{%- if 'mongodb' in datastores %}
    Mongo(MongoArtifactStore),
{%- endif %}
{%- if mysql_engine %}
    MySql(MySqlArtifactStore),
{%- endif %}
{%- if 'postgres' in datastores %}
    Postgres(PostgresArtifactStore),
{%- endif %}
{%- if 'redis' in datastores %}
    Redis(RedisArtifactStore),
{%- endif %}
{%- if 'sqlserver' in datastores %}
    SqlServer(SqlServerArtifactStore),
{%- endif %}
}

impl ArtifactStore for AnyStore {
    async fn save(&self, job_id: &str, content: &str) -> Result<String, PortError> {
        match self {
{%- if 'cosmosdb' in datastores %}
            Self::Cosmos(store) => store.save(job_id, content).await,
{%- endif %}
{%- if 'dynamodb' in datastores %}
            Self::Dynamo(store) => store.save(job_id, content).await,
{%- endif %}
            Self::InMemory(store) => store.save(job_id, content).await,
{%- if 'mongodb' in datastores %}
            Self::Mongo(store) => store.save(job_id, content).await,
{%- endif %}
{%- if mysql_engine %}
            Self::MySql(store) => store.save(job_id, content).await,
{%- endif %}
{%- if 'postgres' in datastores %}
            Self::Postgres(store) => store.save(job_id, content).await,
{%- endif %}
{%- if 'redis' in datastores %}
            Self::Redis(store) => store.save(job_id, content).await,
{%- endif %}
{%- if 'sqlserver' in datastores %}
            Self::SqlServer(store) => store.save(job_id, content).await,
{%- endif %}
        }
    }
}

/// Picks the adapter from configuration; in-memory when nothing is configured.
async fn open_store() -> Result<AnyStore, BoxError> {
{%- if 'postgres' in datastores %}
    if let Ok(url) = std::env::var("DATABASE_URL") {
        return Ok(AnyStore::Postgres(PostgresArtifactStore::connect(&url).await?));
    }
{%- endif %}
{%- if mysql_engine %}
    if let Ok(url) = std::env::var("MYSQL_URL") {
        return Ok(AnyStore::MySql(MySqlArtifactStore::connect(&url).await?));
    }
{%- endif %}
{%- if 'cosmosdb' in datastores %}
    if let Ok(endpoint) = std::env::var("COSMOS_ENDPOINT") {
        let settings = CosmosSettings {
            endpoint,
            key: std::env::var("COSMOS_KEY").unwrap_or_default(),
            database: std::env::var("COSMOS_DATABASE").unwrap_or_else(|_| "app".to_owned()),
            region: std::env::var("COSMOS_REGION").unwrap_or_else(|_| "eastus".to_owned()),
            create_if_missing: std::env::var("COSMOS_CREATE_IF_MISSING").is_ok_and(|value| value == "true"),
        };
        return Ok(AnyStore::Cosmos(CosmosArtifactStore::connect(&settings).await?));
    }
{%- endif %}
{%- if 'dynamodb' in datastores %}
    if let Ok(table) = std::env::var("DYNAMODB_TABLE") {
        let endpoint = std::env::var("DYNAMODB_ENDPOINT").ok();
        return Ok(AnyStore::Dynamo(DynamoArtifactStore::connect(&table, endpoint.as_deref()).await?));
    }
{%- endif %}
{%- if 'mongodb' in datastores %}
    if let Ok(url) = std::env::var("MONGODB_URL") {
        return Ok(AnyStore::Mongo(MongoArtifactStore::connect(&url).await?));
    }
{%- endif %}
{%- if 'sqlserver' in datastores %}
    if let Ok(url) = std::env::var("SQLSERVER_URL") {
        return Ok(AnyStore::SqlServer(SqlServerArtifactStore::connect(&url).await?));
    }
{%- endif %}
{%- if 'redis' in datastores %}
    if let Ok(url) = std::env::var("REDIS_URL") {
        return Ok(AnyStore::Redis(RedisArtifactStore::connect(&url).await?));
    }
{%- endif %}
    Ok(AnyStore::InMemory(InMemoryArtifactStore::default()))
}
{%- endif %}

#[tokio::main]
async fn main() -> ExitCode {
    match run().await {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            let _ = writeln!(std::io::stderr(), "{error}");
            ExitCode::FAILURE
        }
    }
}
{%- if http_api %}

/// Serves the HTTP API until Ctrl+C or SIGTERM, then shuts down gracefully.
async fn run() -> Result<(), BoxError> {
    let store = {% if datastores %}open_store().await?{% else %}InMemoryArtifactStore::default(){% endif %};
    // Loopback by default; the container image sets HOST=0.0.0.0 explicitly.
    let host = std::env::var("HOST").unwrap_or_else(|_| "127.0.0.1".to_owned());
    let port: u16 = std::env::var("PORT").unwrap_or_else(|_| "8080".to_owned()).parse()?;
    let listener = tokio::net::TcpListener::bind((host.as_str(), port)).await?;
    writeln!(std::io::stdout(), "listening on http://{}", listener.local_addr()?)?;
    axum::serve(listener, router(store)).with_graceful_shutdown(shutdown_signal()).await?;
    Ok(())
}

async fn shutdown_signal() {
    let ctrl_c = async {
        let _ = tokio::signal::ctrl_c().await;
    };
    #[cfg(unix)]
    let terminate = async {
        if let Ok(mut signal) = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate()) {
            signal.recv().await;
        }
    };
    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();
    tokio::select! {
        () = ctrl_c => {},
        () = terminate => {},
    }
}
{%- else %}

/// Completes a demo export and prints its artifact key.
async fn run() -> Result<(), BoxError> {
    let store = {% if datastores %}open_store().await?{% else %}InMemoryArtifactStore::default(){% endif %};
    let ready = complete_export(&store, start(Queued::new("demo")), "id,name\n1,demo\n").await?;
    writeln!(std::io::stdout(), "{} -> {}", ready.id(), ready.artifact_key())?;
    Ok(())
}
