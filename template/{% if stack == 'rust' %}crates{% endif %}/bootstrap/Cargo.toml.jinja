# Bootstrap: reads configuration and wires adapters to use cases (ADR 0001). It must not depend on
# datastore drivers directly; adapters own them (ci/check-layers.sh).
[package]
name = "bootstrap"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[lints]
workspace = true

[[bin]]
name = "{{ project_name | lower }}"
path = "src/main.rs"

[dependencies]
adapters = { path = "../adapters" }
application = { path = "../application" }
domain = { path = "../domain" }
tokio = { version = "1", features = ["macros", "rt-multi-thread"{% if serve_http %}, "net", "signal"{% endif %}] }
{%- if serve_http %}
axum = "0.8"
{%- endif %}
{%- if frontend == 'ssr' and http_api %}

[dev-dependencies]
http-body-util = "0.1"
tower = { version = "0.5", default-features = false, features = ["util"] }
{%- endif %}
