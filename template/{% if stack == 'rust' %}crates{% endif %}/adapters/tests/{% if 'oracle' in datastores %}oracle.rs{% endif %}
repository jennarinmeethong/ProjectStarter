impl common::ReadBack for OracleArtifactStore {
    fn read_back(&self, key: &str) -> impl Future<Output = Result<Option<String>, PortError>> + Send {
        self.read(key)
    }
}

/// Same steps as the compose migrate job: sqlplus applies migrations/oracle in file-name order.
async fn migrate(container: &ContainerAsync<GenericImage>) -> Result<(), PortError> {
    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../migrations/oracle");
    let mut files = std::fs::read_dir(dir)?
        .map(|entry| entry.map(|e| e.path()))
        .collect::<Result<Vec<_>, _>>()?
        .into_iter()
        .filter(|path| path.extension().is_some_and(|ext| ext == "sql"))
        .collect::<Vec<_>>();
    files.sort();
    for file in files {
        let script = format!(
            "{{ echo 'WHENEVER SQLERROR EXIT FAILURE'; cat; echo EXIT; }} <<'SQL' | \
             sqlplus -s -L app/app-test-only@//localhost:1521/FREEPDB1\n{}\nSQL",
            std::fs::read_to_string(file)?.trim()
        );
        let mut result = container.exec(ExecCommand::new(["bash", "-c", &script])).await?;
        // Reading the output waits for the command to finish; only then is the exit code known.
        let output = String::from_utf8_lossy(&result.stdout_to_vec().await?).into_owned();
        if result.exit_code().await? != Some(0) {
            return Err(format!("migration failed: {output}").into());
        }
    }
    Ok(())
}

#[tokio::test]
async fn oracle_store_satisfies_the_contract() -> Result<(), PortError> {
    let container = GenericImage::new("gvenzl/oracle-free", "23-slim-faststart")
        .with_exposed_port(1521.tcp())
        .with_wait_for(WaitFor::message_on_stdout("DATABASE IS READY TO USE!"))
        .with_env_var("ORACLE_PASSWORD", "sys-test-only")
        .with_env_var("APP_USER", "app")
        .with_env_var("APP_USER_PASSWORD", "app-test-only")
        .start()
        .await?;
    migrate(&container).await?;
    let host = container.get_host().await?;
    let port = container.get_host_port_ipv4(1521).await?;
    let store =
        OracleArtifactStore::connect(&format!("oracle://app:app-test-only@{host}:{port}/FREEPDB1")).await?;

    common::check_contract(&store).await
}
