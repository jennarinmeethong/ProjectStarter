//! Integration test: needs Docker. Run with `cargo test -p adapters --features integration`.
#![cfg(feature = "integration")]

mod common;

use std::future::Future;

use adapters::redis_store::RedisArtifactStore;
use application::PortError;
use testcontainers_modules::redis::Redis;
use testcontainers_modules::testcontainers::ImageExt;
use testcontainers_modules::testcontainers::runners::AsyncRunner;

impl common::ReadBack for RedisArtifactStore {
    fn read_back(&self, key: &str) -> impl Future<Output = Result<Option<String>, PortError>> + Send {
        self.read(key)
    }
}

#[tokio::test]
async fn redis_store_satisfies_the_contract() -> Result<(), PortError> {
    let container = Redis::default().with_tag("8-alpine").start().await?;
    let host = container.get_host().await?;
    let port = container.get_host_port_ipv4(6379).await?;
    let store = RedisArtifactStore::connect(&format!("redis://{host}:{port}/0")).await?;

    common::check_contract(&store).await
}
