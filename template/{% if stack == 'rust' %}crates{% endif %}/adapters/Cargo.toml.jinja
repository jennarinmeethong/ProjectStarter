# Adapters: implement application ports. The only crate that may depend on datastore drivers and web
# frameworks (ADR 0001, ADR 0003{% if http_api %}, ADR 0004{% endif %}); ci/check-layers.sh checks the other crates.
[package]
name = "adapters"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[lints]
workspace = true
{%- if datastores %}

[features]
# Contract tests against real datastores (Testcontainers, needs Docker): cargo test -p adapters --features integration
integration = []
{%- endif %}

[dependencies]
application = { path = "../application" }
domain = { path = "../domain" }
{%- if sql_store %}
# sqlx 0.9 only accepts SQL it can prove is not built from strings (SqlSafeStr); see ADR 0003.
sqlx = { version = "0.9", default-features = false, features = ["runtime-tokio"{% if 'postgres' in datastores %}, "postgres"{% endif %}{% if mysql_engine %}, "mysql"{% endif %}] }
{%- endif %}
{%- if 'sqlserver' in datastores %}
# tiberius takes SQL from any string: clippy.toml in this crate funnels it through &'static str gateways (ADR 0003).
tiberius = { version = "0.13", default-features = false, features = ["tds73", "rustls"] }
tokio = { version = "1", features = ["net", "sync"] }
tokio-util = { version = "0.7", features = ["compat"] }
url = "2"
percent-encoding = "2"
{%- endif %}
{%- if 'redis' in datastores %}
redis = { version = "1.8", default-features = false, features = ["tokio-comp"] }
{%- endif %}
{%- if 'cosmosdb' in datastores %}
# The Rust Cosmos DB SDK is still in beta: pinned exactly, because betas change the API.
azure_core = "1.1"
azure_data_cosmos = { version = "=1.1.0-beta.2", features = ["key_auth", "control_plane"] }
{%- endif %}
{%- if 'dynamodb' in datastores or 's3' in datastores %}
# AWS SDK without default features: the defaults also pull the legacy hyper 0.14/rustls 0.21 stack, which has
# open advisories (cargo deny). default-https-client is hyper 1 + rustls 0.23.
aws-config = { version = "1", default-features = false, features = ["behavior-version-latest", "rt-tokio", "default-https-client", "credentials-process", "sso"] }
{%- endif %}
{%- if 'dynamodb' in datastores %}
aws-sdk-dynamodb = { version = "1", default-features = false, features = ["rt-tokio", "default-https-client"] }
{%- endif %}
{%- if 's3' in datastores %}
aws-sdk-s3 = { version = "1", default-features = false, features = ["rt-tokio", "default-https-client"] }
{%- endif %}
{%- if 'mongodb' in datastores %}
mongodb = "3"
{%- endif %}
{%- if http_api %}
axum = "0.8"
{%- endif %}
{%- if http_api or 'mongodb' in datastores or 'cosmosdb' in datastores %}
serde = { version = "1", features = ["derive"] }
{%- endif %}
{%- if http_api %}
serde_json = "1"
{%- endif %}

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
{%- if datastores %}
{%- set modules = [] %}
{%- if mysql_engine %}{% set _ = modules.append('"' ~ mysql_engine ~ '"') %}{% endif %}
{%- if 'postgres' in datastores %}{% set _ = modules.append('"postgres"') %}{% endif %}
{%- if 'dynamodb' in datastores %}{% set _ = modules.append('"dynamodb"') %}{% endif %}
{%- if 'mongodb' in datastores %}{% set _ = modules.append('"mongo"') %}{% endif %}
{%- if 'sqlserver' in datastores %}{% set _ = modules.append('"mssql_server"') %}{% endif %}
{%- if 'redis' in datastores %}{% set _ = modules.append('"redis"') %}{% endif %}
testcontainers-modules = { version = "0.15", features = [{{ modules | join(', ') }}] }
{%- endif %}
{%- if 'cosmosdb' in datastores or 's3' in datastores %}
# HTTP readiness checks for images without a module (Cosmos DB emulator, S3Mock).
testcontainers = { version = "0.27", features = ["http_wait"] }
{%- endif %}
