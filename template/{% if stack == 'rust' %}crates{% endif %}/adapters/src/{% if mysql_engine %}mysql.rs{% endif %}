//! `ArtifactStore` on MySQL or MariaDB. Schema: `migrations/mysql/`.
//!
//! Queries are constants with placeholders. sqlx 0.9 only accepts SQL that implements `SqlSafeStr`
//! (string literals), so SQL built from values does not compile (ADR 0003).

use application::{ArtifactStore, PortError};
use sqlx::MySqlPool;
use sqlx::mysql::MySqlPoolOptions;

const UPSERT_SQL: &str = "INSERT INTO export_artifacts (artifact_key, job_id, body) VALUES (?, ?, ?) \
     ON DUPLICATE KEY UPDATE body = VALUES(body)";
const READ_SQL: &str = "SELECT body FROM export_artifacts WHERE artifact_key = ?";

/// Keeps artifacts in the `export_artifacts` table.
#[derive(Debug, Clone)]
pub struct MySqlArtifactStore {
    pool: MySqlPool,
}

impl MySqlArtifactStore {
    /// Connects to `url` (mysql://user:pass@host:port/db).
    pub async fn connect(url: &str) -> Result<Self, PortError> {
        let pool = MySqlPoolOptions::new().max_connections(5).connect(url).await?;
        Ok(Self { pool })
    }

    /// Returns the content stored under `key`, if any.
    pub async fn read(&self, key: &str) -> Result<Option<String>, PortError> {
        let row: Option<(String,)> = sqlx::query_as(READ_SQL).bind(key).fetch_optional(&self.pool).await?;
        Ok(row.map(|(body,)| body))
    }
}

impl ArtifactStore for MySqlArtifactStore {
    async fn save(&self, job_id: &str, content: &str) -> Result<String, PortError> {
        let key = format!("exports/{job_id}.csv");
        sqlx::query(UPSERT_SQL).bind(&key).bind(job_id).bind(content).execute(&self.pool).await?;
        Ok(key)
    }
}
