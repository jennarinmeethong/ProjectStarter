    #[tokio::test]
    async fn rejects_repeated_or_too_many_fields() {
        let app = app();
        let (token, cookie) = open(&app).await;
        let repeated = post(
            &app,
            &cookie,
            &[],
            &[("csrf_token", &token), ("job_id", "a"), ("job_id", "b"), ("content", "x")],
        )
        .await;
        assert_eq!(repeated.status, StatusCode::BAD_REQUEST);
        let names: Vec<String> = (0..MAX_FORM_FIELDS).map(|n| format!("extra{n}")).collect();
        let mut fields = vec![("csrf_token", token.as_str()), ("job_id", "a"), ("content", "x")];
        fields.extend(names.iter().map(|name| (name.as_str(), "1")));
        let many = post(&app, &cookie, &[], &fields).await;
        assert_eq!(many.status, StatusCode::BAD_REQUEST);
        let ten = post(&app, &cookie, &[], &fields[..MAX_FORM_FIELDS]).await;
        assert_eq!(ten.status, StatusCode::OK);
    }

    #[tokio::test]
    async fn escapes_user_input() {
        let app = app();
        let (token, cookie) = open(&app).await;
        let reply = post(
            &app,
            &cookie,
            &[],
            &[
                ("csrf_token", &token),
                ("job_id", "<script>alert(1)</script>"),
                ("content", "</textarea><b>x</b>"),
            ],
        )
        .await;
        assert_eq!(reply.status, StatusCode::BAD_REQUEST);
        assert!(!reply.body.contains("<script>alert"));
        assert!(!reply.body.contains("<b>x</b>"));
        assert!(
            reply.body.contains("&lt;script&gt;alert(1)&lt;/script&gt;")
                || reply.body.contains("&#60;script&#62;alert(1)&#60;/script&#62;")
        );
    }

    #[tokio::test]
    async fn rejects_a_missing_or_mismatched_token() {
        let app = app();
        let (token, cookie) = open(&app).await;
        let other = new_token().unwrap();
        let cases: [Vec<(&str, &str)>; 4] = [
            vec![("job_id", "a"), ("content", "x")],
            vec![("csrf_token", ""), ("job_id", "a"), ("content", "x")],
            vec![("csrf_token", &other), ("job_id", "a"), ("content", "x")],
            vec![("csrf_token", "short"), ("job_id", "a"), ("content", "x")],
        ];
        for fields in cases {
            let reply = post(&app, &cookie, &[], &fields).await;
            assert_eq!(reply.status, StatusCode::FORBIDDEN, "{fields:?}");
            assert!(reply.body.contains("The form has expired."));
        }
        // The refusal keeps the visitor's token, so the open form still works after a reload.
        assert_eq!(
            post(&app, &cookie, &[], &[("csrf_token", &other), ("job_id", "a"), ("content", "x")])
                .await
                .token(),
            token
        );
    }

