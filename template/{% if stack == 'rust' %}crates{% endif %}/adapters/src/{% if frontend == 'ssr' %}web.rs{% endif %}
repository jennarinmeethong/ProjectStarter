    }

    #[tokio::test]
    async fn checks_where_the_request_came_from_before_reading_the_body() {
        // An oversized body from another site is a 403, not a 400: the body is never read.
        let app = app();
        let (_, cookie) = open(&app).await;
        let body = "x".repeat(MAX_FORM_BYTES + 1);
        let reply = send(
            &app,
            (Method::POST, "/"),
            &[FORM, ("cookie", &cookie), ("sec-fetch-site", "cross-site")],
            &body,
        )
        .await;
        assert_eq!(reply.status, StatusCode::FORBIDDEN);
    }

    #[tokio::test]
    async fn keeps_the_token_while_valid() {
        let app = app();
        let (token, cookie) = open(&app).await;
        let again = send(&app, (Method::GET, "/"), &[("cookie", &cookie)], "").await;
        assert_eq!(again.token(), token);
        let sent =
            post(&app, &cookie, &[], &[("csrf_token", &token), ("job_id", "a"), ("content", "x")]).await;
        assert_eq!(sent.token(), token);
    }

    #[tokio::test]
    async fn reports_a_storage_failure_without_details() {
        let store = FailingStore::default();
        let app = web_router(store.clone());
        let (token, cookie) = open(&app).await;
        let reply = post(
            &app,
            &cookie,
            &[],
            &[("csrf_token", &token), ("job_id", "secret-job"), ("content", "private")],
        )
        .await;
        assert_eq!(reply.status, StatusCode::INTERNAL_SERVER_ERROR);
        assert!(reply.body.contains("The export could not be saved."));
        assert!(!reply.body.contains("disk full"));
        assert_eq!(store.asked.lock().unwrap().as_slice(), ["secret-job"]);
    }

    #[tokio::test]
    async fn health_check_answers_ok_with_the_api_policy() {
        let reply = send(&app(), (Method::GET, "/healthz"), &[], "").await;
        assert_eq!(reply.status, StatusCode::OK);
        assert_eq!(reply.body, r#"{"status":"ok"}"#);
        assert_eq!(reply.header("content-type"), "application/json");
        assert_eq!(reply.header("content-security-policy"), API_CSP);
        assert_eq!(reply.header("x-content-type-options"), "nosniff");
    }

    #[tokio::test]
    async fn answers_unknown_routes_with_404_and_no_json_api() {
        for path in ["/does-not-exist", "/exports/job-1/complete"] {
            let reply = send(&app(), (Method::POST, path), &[], "{}").await;
            assert_eq!(reply.status, StatusCode::NOT_FOUND, "{path}");
            assert_eq!(reply.header("x-content-type-options"), "nosniff");
        }
    }

    #[test]
    fn tokens_are_random_url_safe_and_compare_in_constant_time() {
        let (first, second) = (new_token().unwrap(), new_token().unwrap());
        assert!(is_token(&first) && is_token(&second));
        assert_ne!(first, second);
        assert!(tokens_match(&first, &first));
        assert!(!tokens_match(&first, &second));
        assert!(!tokens_match("", ""));
    }
