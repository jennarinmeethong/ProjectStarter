[project]
name = "{{ project_name | lower }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">=3.12"
{%- if datastores %}
dependencies = [
{%- if 'postgres' in datastores %}
    "psycopg[binary]>=3.2",
{%- endif %}
{%- if 'redis' in datastores %}
    "redis>=6.0",
{%- endif %}
]
{%- else %}
dependencies = []
{%- endif %}

[project.scripts]
{{ project_name | lower }} = "{{ package_name }}.bootstrap.main:main"

[dependency-groups]
dev = [
    "hypothesis>=6.100",
    "import-linter>=2.1",
    "pyright>=1.1.400",
    "pytest>=8.3",
    "ruff>=0.12",
{%- if datastores %}
    "testcontainers>=4.10",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
{%- if datastores %}
# Integration tests need Docker: deselected here, run with `uv run pytest -m integration`.
addopts = ["--strict-markers", "--import-mode=importlib", "-m", "not integration"]
markers = ["integration: needs Docker (Testcontainers)"]
{%- else %}
addopts = ["--strict-markers", "--import-mode=importlib"]
{%- endif %}
