{%- set deps = [] -%}
{%- if http_api %}{% set _ = deps.append('"fastapi>=0.120"') %}{% set _ = deps.append('"uvicorn>=0.38"') %}{% endif -%}
{%- if 'postgres' in datastores %}{% set _ = deps.append('"psycopg[binary]>=3.2"') %}{% endif -%}
{%- if mysql_engine %}{% set _ = deps.append('"PyMySQL>=1.1"') %}{% endif -%}
{%- if 'sqlserver' in datastores %}{% set _ = deps.append('"mssql-python>=1.10"') %}{% endif -%}
{%- if 'oracle' in datastores %}{% set _ = deps.append('"oracledb>=3.0"') %}{% endif -%}
{%- if 'mongodb' in datastores %}{% set _ = deps.append('"pymongo>=4.10"') %}{% endif -%}
{%- if 'dynamodb' in datastores or 's3' in datastores %}{% set _ = deps.append('"boto3>=1.40"') %}{% endif -%}
{%- if 'cosmosdb' in datastores %}{% set _ = deps.append('"azure-cosmos>=4.9"') %}{% endif -%}
{%- if 'redis' in datastores %}{% set _ = deps.append('"redis>=6.0"') %}{% endif -%}
{%- set markers = [] -%}
{%- if datastores %}{% set _ = markers.append('integration') %}{% endif -%}
{%- if http_api %}{% set _ = markers.append('e2e') %}{% endif -%}
[project]
name = "{{ project_name | lower }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">=3.12"
{%- if deps %}
dependencies = [
{%- for d in deps %}
    {{ d }},
{%- endfor %}
]
{%- else %}
dependencies = []
{%- endif %}

[project.scripts]
{{ project_name | lower }} = "{{ package_name }}.bootstrap.main:main"

[dependency-groups]
dev = [
    "hypothesis>=6.100",
    "import-linter>=2.1",
    "mutmut>=3.8,<4",
{%- if http_api %}
    "playwright>=1.64",
{%- endif %}
    "pyright>=1.1.400",
    "pytest>=8.3",
    "ruff>=0.12",
{%- if datastores %}
    "testcontainers>=4.10",
{%- endif %}
{%- set boto_stubs = [] %}
{%- if 'dynamodb' in datastores %}{% set _ = boto_stubs.append('dynamodb') %}{% endif %}
{%- if 's3' in datastores %}{% set _ = boto_stubs.append('s3') %}{% endif %}
{%- if boto_stubs %}
    "types-boto3-lite[{{ boto_stubs | join(',') }}]>=1.40",
{%- endif %}
{%- if mysql_engine %}
    "types-PyMySQL>=1.1",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

# Mutation testing of the domain layer: `uv run mutmut run`, gated by ci/mutation-gate.py (Linux/macOS/WSL; CI runs it).
# also_copy brings the rest of the package so tests that import other layers still collect; it copies
# the domain too, so each run re-mutates from scratch (no incremental results; fine for a small domain).
[tool.mutmut]
source_paths = ["src/{{ package_name }}/domain/"]
also_copy = ["src/{{ package_name }}/"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
{%- if markers %}
# Deselected by default so the inner loop stays fast:
{%- if datastores %}
#   integration (needs Docker): uv run pytest -m integration
{%- endif %}
{%- if http_api %}
#   e2e (real HTTP server + Playwright): uv run pytest -m e2e
{%- endif %}
addopts = ["--strict-markers", "--import-mode=importlib", "-m", "{% for m in markers %}not {{ m }}{% if not loop.last %} and {% endif %}{% endfor %}"]
markers = [
{%- if datastores %}
    "integration: needs Docker (Testcontainers)",
{%- endif %}
{%- if http_api %}
    "e2e: starts the HTTP server and calls it with Playwright",
{%- endif %}
]
{%- else %}
addopts = ["--strict-markers", "--import-mode=importlib"]
{%- endif %}
