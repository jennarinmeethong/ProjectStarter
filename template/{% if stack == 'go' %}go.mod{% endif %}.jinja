module {{ go_module }}

go 1.26.0

// Patched toolchain: the Go command downloads it automatically, and govulncheck checks its standard library.
toolchain go1.26.11

// Lint and vulnerability scanners are pinned here and run with `go tool`, so every machine and CI
// use the same versions.
tool (
	github.com/golangci/golangci-lint/v2/cmd/golangci-lint
	golang.org/x/vuln/cmd/govulncheck
)

require (
{%- if 'dynamodb' in datastores %}
	github.com/aws/aws-sdk-go-v2 v1.48.0
	github.com/aws/aws-sdk-go-v2/config v1.33.19
	github.com/aws/aws-sdk-go-v2/service/dynamodb v1.74.1
{%- endif %}
	github.com/golangci/golangci-lint/v2 v2.15.0
	golang.org/x/vuln v1.9.0
	github.com/quasilyte/go-ruleguard/dsl v0.3.23 // used by ci/gorules (build tag ruleguard)
{%- if 'mongodb' in datastores %}
	github.com/testcontainers/testcontainers-go/modules/mongodb v0.44.0
	go.mongodb.org/mongo-driver/v2 v2.9.3
{%- endif %}
{%- if 'sqlserver' in datastores %}
	github.com/microsoft/go-mssqldb v1.11.1
	github.com/testcontainers/testcontainers-go/modules/mssql v0.44.0
{%- endif %}
{%- if mysql_engine %}
	github.com/go-sql-driver/mysql v1.10.1
	github.com/testcontainers/testcontainers-go/modules/{{ mysql_engine }} v0.44.0
{%- endif %}
{%- if 'postgres' in datastores %}
	github.com/jackc/pgx/v5 v5.12.0
	github.com/testcontainers/testcontainers-go/modules/postgres v0.44.0
{%- endif %}
{%- if 'redis' in datastores %}
	github.com/redis/go-redis/v9 v9.23.0
	github.com/testcontainers/testcontainers-go/modules/redis v0.44.0
{%- endif %}
{%- if datastores %}
	github.com/testcontainers/testcontainers-go v0.44.0
{%- endif %}
{%- if http_api %}
	github.com/mxschmitt/playwright-go v0.6201.1
{%- endif %}
)
