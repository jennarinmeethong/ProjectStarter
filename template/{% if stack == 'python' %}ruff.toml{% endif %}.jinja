# Guardrail config (protected). See docs/adr/ for why each rule exists.
target-version = "py312"
line-length = 100
src = ["src", "tests"]

[lint]
select = [
    "E", "W", "F",   # pycodestyle, pyflakes
    "I",             # import order
    "B",             # bugbear
    "UP",            # modern syntax
    "ANN",           # type annotations everywhere
    "PGH",           # no blanket `type: ignore` / `noqa`
    "RUF",           # incl. RUF100 unused noqa
    "SIM", "PT", "DTZ",
    "TID",           # banned APIs below
]

[lint.flake8-tidy-imports.banned-api]
"time.sleep".msg = "No sleeps in product code: model the state or inject a scheduler port (docs/engineering/agent-principles.md #2)."
"typing.cast".msg = "Do not cast to silence the type checker. Validate/decode the value at the boundary instead (docs/adr/0001-layered-architecture.md)."

[lint.per-file-ignores]
"src/{{ package_name }}/adapters/**" = ["TID251"]
