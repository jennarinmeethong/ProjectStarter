using {{ dotnet_name }}.Adapters;
using {{ dotnet_name }}.Application;
{%- if http_api %}
using {{ dotnet_name }}.Bootstrap;
{%- else %}
using {{ dotnet_name }}.Domain;
{%- endif %}

// Bootstrap is the only place that reads configuration; adapters receive plain values (ADR 0003).
IArtifactStore store = new InMemoryArtifactStore();
{%- if datastores %}
IAsyncDisposable? owned = null;
{%- if 'postgres' in datastores %}
var databaseUrl = Environment.GetEnvironmentVariable("DATABASE_URL");
if (owned is null && !string.IsNullOrEmpty(databaseUrl))
{
    var postgres = PostgresArtifactStore.Create(databaseUrl);
    (store, owned) = (postgres, postgres);
}
{%- endif %}
{%- if mysql_engine %}
var mysqlUrl = Environment.GetEnvironmentVariable("MYSQL_URL");
if (owned is null && !string.IsNullOrEmpty(mysqlUrl))
{
    var mysql = MySqlArtifactStore.Create(mysqlUrl);
    (store, owned) = (mysql, mysql);
}
{%- endif %}
{%- if 'cosmosdb' in datastores %}
var cosmosEndpoint = Environment.GetEnvironmentVariable("COSMOS_ENDPOINT");
if (owned is null && !string.IsNullOrEmpty(cosmosEndpoint))
{
    var cosmos = await CosmosArtifactStore.ConnectAsync(
        cosmosEndpoint,
        Environment.GetEnvironmentVariable("COSMOS_KEY") ?? string.Empty,
        Environment.GetEnvironmentVariable("COSMOS_DATABASE") ?? "app",
        Environment.GetEnvironmentVariable("COSMOS_CREATE_IF_MISSING") == "true");
    (store, owned) = (cosmos, cosmos);
}
{%- endif %}
{%- if 'dynamodb' in datastores %}
var dynamoTable = Environment.GetEnvironmentVariable("DYNAMODB_TABLE");
if (owned is null && !string.IsNullOrEmpty(dynamoTable))
{
    var dynamo = DynamoArtifactStore.Create(dynamoTable, Environment.GetEnvironmentVariable("DYNAMODB_ENDPOINT"));
    (store, owned) = (dynamo, dynamo);
}
{%- endif %}
{%- if 'mongodb' in datastores %}
var mongoUrl = Environment.GetEnvironmentVariable("MONGODB_URL");
if (owned is null && !string.IsNullOrEmpty(mongoUrl))
{
    var mongo = await MongoArtifactStore.ConnectAsync(mongoUrl);
    (store, owned) = (mongo, mongo);
}
{%- endif %}
{%- if 'oracle' in datastores %}
var oracleUrl = Environment.GetEnvironmentVariable("ORACLE_URL");
if (owned is null && !string.IsNullOrEmpty(oracleUrl))
{
    var oracle = OracleArtifactStore.Create(oracleUrl);
    (store, owned) = (oracle, oracle);
}
{%- endif %}
{%- if 'sqlserver' in datastores %}
var sqlServerUrl = Environment.GetEnvironmentVariable("SQLSERVER_URL");
if (owned is null && !string.IsNullOrEmpty(sqlServerUrl))
{
    var sqlServer = SqlServerArtifactStore.Create(sqlServerUrl);
    (store, owned) = (sqlServer, sqlServer);
}
{%- endif %}
{%- if 's3' in datastores %}
var s3Bucket = Environment.GetEnvironmentVariable("S3_BUCKET");
if (owned is null && !string.IsNullOrEmpty(s3Bucket))
{
    var s3 = S3ArtifactStore.Create(s3Bucket, Environment.GetEnvironmentVariable("S3_ENDPOINT"));
    (store, owned) = (s3, s3);
}
{%- endif %}
{%- if 'redis' in datastores %}
var redisUrl = Environment.GetEnvironmentVariable("REDIS_URL");
if (owned is null && !string.IsNullOrEmpty(redisUrl))
{
    var redis = await RedisArtifactStore.ConnectAsync(redisUrl);
    (store, owned) = (redis, redis);
}
{%- endif %}
{%- endif %}
{%- if http_api %}

// Loopback by default; the container image sets HOST=0.0.0.0 explicitly.
var host = Environment.GetEnvironmentVariable("HOST") ?? "127.0.0.1";
var port = Environment.GetEnvironmentVariable("PORT") ?? "8080";
await using var app = HttpHost.Build(store, $"http://{host}:{port}");
{%- if datastores %}
try
{
    await app.RunAsync();
}
finally
{
    if (owned is not null)
    {
        await owned.DisposeAsync();
    }
}
{%- else %}
await app.RunAsync();
{%- endif %}
{%- elif datastores %}

try
{
    var job = ExportTransitions.Start(new ExportJob.Queued("demo"));
    var ready = await new CompleteExport(store).ExecuteAsync(job, "id,name\n1,demo\n", CancellationToken.None);
    Console.WriteLine($"{ready.Id} -> {ready.ArtifactKey}");
}
finally
{
    if (owned is not null)
    {
        await owned.DisposeAsync();
    }
}
{%- else %}

var job = ExportTransitions.Start(new ExportJob.Queued("demo"));
var ready = await new CompleteExport(store).ExecuteAsync(job, "id,name\n1,demo\n", CancellationToken.None);
Console.WriteLine($"{ready.Id} -> {ready.ArtifactKey}");
{%- endif %}
