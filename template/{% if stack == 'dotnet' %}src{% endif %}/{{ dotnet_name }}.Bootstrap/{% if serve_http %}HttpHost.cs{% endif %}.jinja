{% if http_api %}using {{ dotnet_name }}.Adapters.Http;
{% endif %}{% if frontend == 'ssr' %}using {{ dotnet_name }}.Adapters.Web;
{% endif %}using {{ dotnet_name }}.Application;

namespace {{ dotnet_name }}.Bootstrap;

/// <summary>Builds the HTTP host. Used by Program and by the end-to-end tests, so both run the same pipeline.</summary>
public static class HttpHost
{
{%- if frontend == 'ssr' %}
    /// <param name="keysDirectory">Where the UI keeps its Data Protection keys (antiforgery tokens); null keeps the
    /// framework default, which is lost on restart inside the container (ADR 0005).</param>
    public static WebApplication Build(IArtifactStore store, string url, string? keysDirectory = null)
{%- else %}
    public static WebApplication Build(IArtifactStore store, string url)
{%- endif %}
    {
        var builder = WebApplication.CreateSlimBuilder();
        builder.WebHost.UseUrls(url);
        builder.WebHost.ConfigureKestrel(options => options.AddServerHeader = false);
        builder.Services.AddProblemDetails();
        builder.Services.AddSingleton(store);
        builder.Services.AddSingleton<CompleteExport>();
{%- if frontend == 'ssr' %}
        builder.Services.AddWebUi(keysDirectory);
{%- endif %}

        var app = builder.Build();
        app.UseExceptionHandler();
        app.UseStatusCodePages();
{%- if frontend == 'ssr' %}
        // The UI owns the security headers: the page CSP for the page, the API CSP for /healthz{% if http_api %} and /exports{% endif %}.
        app.MapWebUi();
{%- else %}
        app.UseSecurityHeaders();
{%- endif %}
{%- if http_api %}
        app.MapExportEndpoints();
{%- endif %}
        return app;
    }
}
