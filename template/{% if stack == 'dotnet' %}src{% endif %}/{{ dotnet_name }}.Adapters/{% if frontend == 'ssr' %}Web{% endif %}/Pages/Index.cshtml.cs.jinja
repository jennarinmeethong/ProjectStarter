using System.Text.RegularExpressions;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.Extensions.Logging;
using {{ dotnet_name }}.Application;
using {{ dotnet_name }}.Domain;

namespace {{ dotnet_name }}.Adapters.Web.Pages;

/// <summary>
/// The export form (driving adapter, ADR 0005): decodes and validates the form, calls the use case, renders the result.
/// The cross-site check, the form limits and antiforgery run as filters before the form is bound (FormFilters.cs).
/// A saved export answers 303 to <c>GET /</c> (Post/Redirect/Get), so reloading the result page does not post again;
/// the result travels in a one-time <c>__Host-flash</c> cookie.
/// </summary>
[RequestSizeLimit(WebUi.MaxBodyBytes)]
[RequestFormLimits(ValueCountLimit = WebUi.MaxFields, ValueLengthLimit = WebUi.MaxValueBytes, KeyLengthLimit = 64)]
public sealed partial class IndexModel(CompleteExport useCase, ILogger<IndexModel> logger) : PageModel
{
    private const int MaxContentLength = 1_000_000;
    private const string Invalid = "Enter a job id (letters, digits, - or _) and some content.";
    private const string Failure = "The export could not be saved.";

    [BindProperty(Name = "job_id")]
    public string? JobId { get; set; }

    [BindProperty(Name = "content")]
    public string? ExportContent { get; set; }

    public string? Status { get; private set; }

    public void OnGet()
    {
        if (FlashCookie.Take(this) is { } key)
        {
            Status = $"Saved as {key}";
        }
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken cancellationToken)
    {
        if (JobId is not { } id || !JobIdPattern().IsMatch(id) || ExportContent is not { Length: > 0 and <= MaxContentLength } content)
        {
            Status = Invalid;
            return PageWithStatus(StatusCodes.Status400BadRequest);
        }

        try
        {
            var ready = await useCase.ExecuteAsync(ExportTransitions.Start(new ExportJob.Queued(id)), content, cancellationToken).ConfigureAwait(false);
            return FlashCookie.Redirect(this, ready.ArtifactKey);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // Details go to the log only; the page says what happened, not why.
            LogSaveFailed(logger, id, exception);
            Status = Failure;
            return PageWithStatus(StatusCodes.Status500InternalServerError);
        }
    }

    private PageResult PageWithStatus(int statusCode)
    {
        var result = Page();
        result.StatusCode = statusCode;
        return result;
    }

    [GeneratedRegex("^[A-Za-z0-9_-]{1,64}\\z")]
    private static partial Regex JobIdPattern();

    [LoggerMessage(Level = LogLevel.Error, Message = "Saving export {JobId} failed")]
    private static partial void LogSaveFailed(ILogger logger, string jobId, Exception exception);
}
