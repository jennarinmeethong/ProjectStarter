<!-- Adapters: implement Application ports (ADR 0001). The only project that references datastore drivers (ADR 0003). -->
<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\{{ dotnet_name }}.Application\{{ dotnet_name }}.Application.csproj" />
  </ItemGroup>
{%- if http_api %}
  <ItemGroup>
    <!-- HTTP is a driving adapter: endpoint mapping lives here, hosting lives in Bootstrap. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
{%- endif %}
{%- if datastores %}
  <ItemGroup>
{%- if 'sqlserver' in datastores %}
    <PackageReference Include="Microsoft.Data.SqlClient" />
{%- endif %}
{%- if mysql_engine %}
    <PackageReference Include="MySqlConnector" />
{%- endif %}
{%- if 'postgres' in datastores %}
    <PackageReference Include="Npgsql" />
{%- endif %}
{%- if 'redis' in datastores %}
    <PackageReference Include="StackExchange.Redis" />
{%- endif %}
  </ItemGroup>
{%- endif %}
</Project>
