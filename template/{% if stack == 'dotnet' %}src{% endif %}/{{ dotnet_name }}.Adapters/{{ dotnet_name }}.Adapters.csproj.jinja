<!-- Adapters: implement Application ports (ADR 0001). The only project that references datastore drivers (ADR 0003). -->
<Project Sdk="Microsoft.NET.Sdk{% if frontend == 'ssr' %}.Razor{% endif %}">
  <ItemGroup>
    <ProjectReference Include="..\{{ dotnet_name }}.Application\{{ dotnet_name }}.Application.csproj" />
  </ItemGroup>
{%- if frontend == 'ssr' %}
  <PropertyGroup>
    <!-- Razor Pages (Web/Pages) compile into this assembly; Bootstrap registers it as an application part. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
{%- endif %}
{%- if serve_http %}
  <ItemGroup>
    <!-- HTTP is a driving adapter: endpoint mapping lives here, hosting lives in Bootstrap. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
{%- if frontend == 'ssr' %}
    <EmbeddedResource Include="Web/static/app.css" LogicalName="static/app.css" />
{%- endif %}
  </ItemGroup>
{%- endif %}
{%- if datastores %}
  <ItemGroup>
{%- if 'cosmosdb' in datastores %}
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="Newtonsoft.Json" />
{%- endif %}
{%- if 'dynamodb' in datastores %}
    <PackageReference Include="AWSSDK.DynamoDBv2" />
{%- endif %}
{%- if 's3' in datastores %}
    <PackageReference Include="AWSSDK.S3" />
{%- endif %}
{%- if 'mongodb' in datastores %}
    <PackageReference Include="MongoDB.Driver" />
{%- endif %}
{%- if 'oracle' in datastores %}
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
{%- endif %}
{%- if 'sqlserver' in datastores %}
    <PackageReference Include="Microsoft.Data.SqlClient" />
{%- endif %}
{%- if mysql_engine %}
    <PackageReference Include="MySqlConnector" />
{%- endif %}
{%- if 'postgres' in datastores %}
    <PackageReference Include="Npgsql" />
{%- endif %}
{%- if 'redis' in datastores %}
    <PackageReference Include="StackExchange.Redis" />
{%- endif %}
  </ItemGroup>
{%- endif %}
</Project>
