{
  "permissions": {
    "deny": [
{%- for f in stk.guardrail_files %}
      "Edit(/{{ f }})",
{%- endfor %}
      "Edit(/tests/acceptance/**)",
      "Edit(/ci/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-guardrails.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited-file.sh\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-before-stop.sh\"", "timeout": 600 }
        ]
      }
    ]
  }
}
