#!/usr/bin/env bash
# PostToolUse: lint the file Claude just edited. Exit 2 sends the errors back to Claude (the edit already happened).
. "$(dirname "$0")/_lib.sh"

rel=$(relative_path "$(read_file_path)")
case "$rel" in
  {{ stk.lint_exts }}) ;;
  *) exit 0 ;;
esac

cd "$(project_root)" || exit 0
[ -f "$rel" ] || exit 0

if ! out=$({{ cmd.lint_file }} "$rel" 2>&1); then
  echo "Lint failed for $rel. Fix the cause (do not add suppressions):" >&2
  printf '%s\n' "$out" | tail -n 40 >&2
  exit 2
fi
exit 0
